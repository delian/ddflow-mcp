{"agent":"lane-green","data":{"by":"grok-4.7","evidence":{"chunk_findings":[{"chunk":1,"detail":"`ddflow_verify(..., shas=True)` returns before `_tool_mode_refusal`, so conflicting mode flags are dropped rather than refused. Given `shas=True`, `pack_=True`, and `id=\"T1\"`, the function runs only `verify_shas` and never refuses the pack argument, contradicting the docstring on the same function that other-mode arguments are refused, never dropped.","digest":"2a7101f732e71018","family":"xai","location":"ddflow/api/verify.py:284","malformed":"","reviewer":"grok-4.7","severity":"MEDIUM","title":"ddflow/api/verify.py:284"},{"chunk":2,"detail":"Landed-path matching treats any newer commit whose name-only set is a superset of the recorded files as the rewrite of `sha`. Candidates are newest-first, and the first hit wins even when patch-ids differ. Given a completed item whose sha is not an ancestor of main, `done.files == [\"pkg/a.py\"]`, and tip `bbbb` that only fixes a typo in `pkg/a.py`, `_equivalent` returns `(bbbb, \"landed paths\")` and `check_item` reports `rewritten, equivalent bbbb`. That commit is not the recorded change, so a task that never landed is reported as landed.","digest":"38b172735868237a","family":"xai","location":"ddflow/services/verify_shas.py:_equivalent","malformed":"","reviewer":"grok-4.7","severity":"MEDIUM","title":"ddflow/services/verify_shas.py:_equivalent"}],"chunks_total":3,"coverage":"3/3 chunk(s) reviewed","delta_rounds":0,"diff_chars":15384,"diff_sha":"d338e1f5506d175c638010942c236c2be9e4793b6279484efd2b4199e5b6ac4e","diff_source":"main..HEAD + tracked working-tree changes in $HOME/src/ddflow/.ddflow/worktrees/VF-verify-shas","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":80.3,"excluded_bytes":4587,"excluded_files":2,"excluded_paths":["README.md","tests/golden/__snapshots__/test_golden_cli_help.ambr"],"family":"xai","findings":2,"max_chunk_chars":8000,"model":"grok-4.7","output_digest":"41226c115d48b4ed","output_file":".ddflow/local/reviews/VF-verify-shas.rubber_duck.grok-4.7.20261111T220421Z-a078a149.jsonl","reason":"","review_degraded":[{"at":1794434661.355999,"family":"google","gate":"rubber_duck","model":"gemini-3.5-flash-lite","reason":"HTTP 429","reviewer":"gemini-3.5-flash-lite"}],"review_kind":"full","reviewed":[1,2,3],"reviewed_head":"f1c04fc4a3fbfd751cae6b16d0282909366cc238","reviewed_paths":{"README.md":"100644 e3524115fce7be966d016129c12a39ecc2e93634","ddflow/api/verify.py":"100644 ec92c10017be5b9b59a24d8d8673205c5054c87c","ddflow/services/verify_shas.py":"100644 4eb2bd6469da9aac809e28bc8b31007e31d5675b","ddflow/surfaces/commands/verify.py":"100644 cf1d9a82f9c2e4fd8061becbb5e37c2e93344f64","ddflow/surfaces/declared/review.py":"100644 3bc358016c24d7c63be57f49a775f1f4a20366ee","ddflow/templates/prompts/help/verify.md":"100644 f7ffa5b9d93429b2380e4826340282dc062926c2","tests/golden/__snapshots__/test_golden_cli_help.ambr":"100644 e1b9055745781dbdf8ddf2a8bc187b0972a49de0","tests/test_verify_shas.py":"100644 72bcbd87c064519aba253b22263e53557a3b3bdd"},"reviewer":"grok-4.7","reviewer_digest":"1857ec352c55ee94","reviewer_families":["xai"],"round":1,"rounds":1,"status":"REVIEWED","titles":["ddflow/api/verify.py:284","ddflow/services/verify_shas.py:_equivalent"],"tree_sha":"f1c04fc4a3fb+clean","unreviewed":[],"waves":1},"gate":"rubber_duck","reason":"2 finding(s)"},"id":"e25cb2b5e935edf62238f65c6","kind":"gate.failed","lamport":177929,"schema":1,"subject":"VF-verify-shas","ts":"2026-11-11T22:05:41.990921Z"}
