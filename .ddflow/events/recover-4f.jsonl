{"agent":"recover-4f","data":{"by":"grok-4.7","evidence":{"chunk_findings":[{"chunk":1,"detail":"`deadline_s` is applied as a fresh per-call `timeout` on worktree add, rev-parse, merge-base, and merge, not as one budget for the whole scratch merge. Given `probe_timeout_s=5`, a slow `worktree add` can run 5s and then `merge` another 5s (and merge-base yet another 5s if it is killed: non-zero `.code` is treated as \"not an ancestor\" and the merge is still attempted). `probe._scratch` now blocks in-process on `CI.merge_tree` with no outer cap, so the CLI stays alive well past `[locks].probe_timeout_s` — the outliving-the-deadline failure this change claims to close.","digest":"5887eddd040d459b","family":"xai","location":"ddflow/services/ci/scratch.py:141","reviewer":"grok-4.7","severity":"MEDIUM","title":"ddflow/services/ci/scratch.py:141"}],"chunks_total":2,"coverage":"2/2 chunk(s) reviewed","delta_rounds":0,"diff_chars":9705,"diff_sha":"6408d9ed5c41fce1675d0f7c49ff705d49ed93b9d3db26d7be5e027e249ca247","diff_source":"main..HEAD + tracked working-tree changes in $HOME/src/ddflow/.ddflow/worktrees/LK-probe-scratch-deadline","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":37.8,"family":"xai","findings":1,"max_chunk_chars":8000,"model":"grok-4.7","output_digest":"39dd43676bc9ce9e","output_file":".ddflow/local/reviews/LK-probe-scratch-deadline.critic.grok-4.7.20261108T151712Z-ad1656f0.jsonl","reason":"","review_kind":"full","reviewed":[1,2],"reviewed_head":"6342919fae17f7994e6933c774d85eff58d1791c","reviewed_paths":{"ddflow/infra/worktree/_locate.py":"100644 7fc42073c28481bf58fab03272504a2b9009c05f","ddflow/services/ci/scratch.py":"100644 b9cc49d1eac42bda1f78d57465fc6d33da548053","ddflow/services/probe.py":"100644 10401239be1b3f8b901c8f173d7c177b27da89b1","tests/test_conflict_probe.py":"100644 4fb010294c9bc43b146339dbf092dc0309d4988a"},"reviewer":"grok-4.7","reviewer_digest":"1857ec352c55ee94","reviewer_families":["google","xai"],"round":1,"