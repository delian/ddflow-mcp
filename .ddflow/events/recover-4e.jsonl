{"agent":"recover-4e","data":{"by":"deepseek-ai/DeepSeek-V4-Pro-0813-Godzila","evidence":{"chunk_findings":[{"chunk":1,"detail":"`at = text.rfind(\"\\n\" + head + \"\\n\")` still treats a fenced `# ddflow brief` line as the anchor because it only searches for the literal string and cannot know whether that line is inside a code fence. When there is no RESUME slice and the real H1 is at the very beginning, a later fenced line becomes the last match: for example, `_under_resume(\"# ddflow brief\\n## Work\\n```text\\n# ddflow brief\\n```\\n\", \"\", \"\", \"## Open workflow choices\\n- pick A\")` inserts the choices block after the opening fence instead of returning `lead + text`. The Open-workflow-choices heading is then inside the code block and is not rendered as a heading, contradicting the helper’s own “fenced `# ddflow brief` must not steal the anchor” contract.","digest":"c3b5a2544c4136b4","family":"deepseek","location":"ddflow/api/lifecycle/brief.py:_under_resume","reviewer":"lan-deepseek-v4-pro","severity":"MEDIUM","title":"ddflow/api/lifecycle/brief.py:_under_resume"},{"chunk":1,"detail":"`_under_resume` anchors with `text.rfind(\"\\n# ddflow brief\\n\")`, so any later exact heading line wins over the view H1. Given `text = \"## Resume\\nstale\\n# ddflow brief\\n## Work\\n```text\\n# ddflow brief\\n```\\n\"` and a non-empty choices/reports lead, the match inside the fence is last, and the lead is spliced into the fence (`## Work\\n```text\\n` + lead + `# ddflow brief\\n````) instead of immediately before the view H1. The new test only covers a fence above the H1; a quote after it (normal in Work notes) hides Open workflow choices inside a code block.","digest":"6867ff6e3aa8ee4a","family":"xai","location":"ddflow/api/lifecycle/brief.py:313","reviewer":"grok-4.7","severity":"MEDIUM","title":"ddflow/api/lifecycle/brief.py:313"}],"chunks_total":1,"coverage":"1/1 chunk(s) reviewed","delta_rounds":0,"diff_chars":4328,"diff_sha":"b3382e660327e6f0985a15471a52ed8365c918eecdfca179efa2ac01c23e81ae","diff_source":"main..HEAD + tracked working-tree changes in $HOME/src/ddflow/.ddflow/worktrees/fix-B-brief-choices-above-resume","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":0.8,"family":"deepseek","findings":2,"max_chunk_chars":12000,"model":"deepseek-ai/DeepSeek-V4-Pro-0813-Godzila","output_digest":"754ed5a53fabc02d","output_file":".ddflow/local/reviews/fix-B-brief-choices-above-resume.critic.gemini-3.5-flash-lite.20261108T121303Z-640aa83a.jsonl","reason":"","review_kind":"full","reviewed":[1],"reviewed_head":"5d8f8c11ae19dc3a81b7149bdfbcefe438dffb9b","reviewed_paths":{"ddflow/api/lifecycle/brief.py":"100644 52e8176205794d93f49b2fd6b9382d30e28c28fd","tests/test_session_start_resume.py":"100644 3e377737989de3f481cfc031938d346be4da3c24"},"reviewer":"lan-deepseek-v4-pro","reviewer_digest":"dd08c1466c2b8632","reviewer_families":["deepseek","google","xai"],"round":5,"rounds":5,"status":"REVIEWED","titles":["ddflow/api/lifecycle/brief.py:_under_resume","ddflow/api/lifecycle/brief.py:313"],"tree_sha":"5d8f8c11ae19+clean","unreviewed":[],"waves":1},"gate":"critic","reason":"2 finding(s)"},"id":"ea7565945afebbbf67923556d","kind":"gate.failed","lamport":154613,"schema":1,"subject":"fix-B-brief-choices-above-resume","ts":"2026-11-08T12:13:41.967794Z"}
