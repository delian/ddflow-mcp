{"agent":"bg116","data":{"by":"grok-4.7","evidence":{"chunk_findings":[{"chunk":1,"detail":"The tick always walks `sorted(templates)` and returns on the first worktree or `LN.launch` failure, so one sticky refusal blocks every later lane forever. Given templates `a` and `b`, both idle and both offered, if `a`'s worktree add fails (missing parent, leftover directory without `.git`) or `launch` returns a refusal, the function returns that note immediately and never builds a request for `b`. The next pass hits `a` again first, so `b` never starts even though it would succeed.","digest":"855672390a658a83","family":"xai","location":"ddflow/api/lifecycle/pull.py:launch_due","reviewer":"grok-4.7","severity":"MEDIUM","title":"ddflow/api/lifecycle/pull.py:launch_due"}],"chunks_total":2,"coverage":"2/2 chunk(s) reviewed","delta_rounds":0,"diff_chars":9985,"diff_sha":"46d3ea3a6a9e314cfb448147cc063d1e0fe2c24ea6033eb0fcab0b9a1408c5f2","diff_source":"main..HEAD + tracked working-tree changes in $HOME/src/ddflow/.ddflow/worktrees/fix-B5c8139e564","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":86.7,"family":"xai","findings":1,"max_chunk_chars":8000,"model":"grok-4.7","output_digest":"d4b1aea92773257b","output_file":".ddflow/local/reviews/fix-B5c8139e564.critic.grok-4.7.20261109T033352Z-59af9ad2.jsonl","reason":"","review_kind":"full","reviewed":[1,2],"reviewed_head":"0f31e56974781b5d91c12f1c1b02d2c49e13554b","reviewed_paths":{"ddflow/api/lifecycle/pull.py":"100644 2982fe9b98249d2d1e43ad4b4ab718acab2d76d9","ddflow/services/ticks.py":"100644 49b5fca425df98d87596084589d0a64fb49d6e0a","tests/test_swarm_launch_tick.py":"100644 ee258f819be67f709a170be65ed9a5d61b50d999"},"reviewer":"grok-4.7","reviewer_digest":"1857ec352c55ee94","reviewer_families":["xai"],"round":1,"rounds":1,"status":"REVIEWED","titles":["ddflow/api/lifecycle/pull.py:launch_due"],"tree_sha":"0f31e5697478+clean","unreviewed":[],"waves":1},"gate":"critic","reason":"1 finding(s)"},"id":"e469