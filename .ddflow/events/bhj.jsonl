{"agent":"bhj","data":{"by":"grok-4.7","evidence":{"chunk_findings":[{"chunk":1,"detail":"The stated invariant is that a phase reporting done holds zero open tasks, and a task becoming open under a done phase must re-open it (imported phases are supposed to refuse that instead). `_reopen_done_parent` is invoked from the `item.reopened` fold, then returns immediately when `parent.id in st.imported_done`, so it neither re-opens nor rejects. Seed an imported completion the same way the new test does (`item.completed` on `P9` with `imported: true` after `P9.T1` is done), then append `item.reopened` for `P9.T1`: the child folds to OPEN while `P9` stays DONE with its completion and gates intact — the same \"done 18/19\" inconsistency, and nothing in this change guards the reopen command the way `closed_phase_parent` guards task add.","digest":"ff37a742217634f8","family":"xai","location":"ddflow/core/handlers/items.py:_reopen_done_parent","reviewer":"grok-4.7","severity":"MEDIUM","title":"ddflow/core/handlers/items.py:_reopen_done_parent"}],"chunks_total":1,"combined_gates":["rubber_duck","critic"],"coverage":"1/1 chunk(s) reviewed","delta_rounds":0,"diff_chars":8417,"diff_sha":"2e45dd741742fbf511b010c9d330a0837c608d16ed05620d1718b9e954f45371","diff_source":"main..HEAD + tracked working-tree changes in $HOME/src/ddflow/.ddflow/worktrees/fix-B86e99de0c6","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":132.7,"family":"xai","findings":1,"max_chunk_chars":8000,"model":"grok-4.7","output_digest":"5b90e83a88115578","output_file":".ddflow/local/reviews/fix-B86e99de0c6.rubber_duck.grok-4.7.20261109T195155Z-ad70c4da.jsonl","reason":"","review_degraded":[{"at":1794253915.88722,"family":"google","gate":"rubber_duck","model":"gemini-3.5-flash-lite","reason":"HTTP 429","reviewer":"gemini-3.5-flash-lite"}],"review_id":"00f48d533fcb","review_kind":"full","reviewed":[1],"reviewed_head":"481887aa5f871e28bee30881216f47dec8d45d46","reviewed_paths":{"ddflow/api/