{"agent":"fx-mcp-ci","data":{"by":"deepseek-ai/DeepSeek-V4-Pro-0813-Godzila","evidence":{"chunk_findings":[{"chunk":1,"detail":"`_progress` now caches and returns one mutable `say` closure per `progressToken`, and line 909 gives that same closure to `heartbeat`. The heartbeat timer must call `say` from a second thread while `_invoke` also calls it for each emitted line, but `count[0] += 1` inside `say` is an unsynchronized read-modify-write. Example: `count[0]` is 10; the heartbeat thread reads 10; the main thread processes two output lines and emits progress 11 and 12; the heartbeat thread then stores 11 and emits `progress: 11` after `12` for the same `progressToken`, so progress decreases, violating MCP's monotonic progress requirement. The counter and send must be serialized with a lock.","digest":"b968dfdaca9dcfba","location":"ddflow/surfaces/mcp.py:_progress (shared with heartbeats)","severity":"MEDIUM","title":"ddflow/surfaces/mcp.py:_progress (shared with heartbeats)"},{"chunk":2,"detail":"`heartbeat` only rejects `every <= 0`; it never checks `math.isfinite(every)`. If `every` is `float(\"nan\")` — either via `[mcp] progress_s = nan` (a valid TOML float) or by a caller passing `heartbeat(..., every=float(\"nan\"))` — the guard passes, a thread is started, and `done.wait(every)` does not sleep (CPython's condition wait treats NaN as non-positive), so the `while not done.wait(every): say(...)` loop becomes a busy spin that floods `notifications/progress` and pegs a CPU for the duration of the call.","digest":"1172815007da3980","location":"ddflow/surfaces/mcp_heartbeat.py:35","severity":"MEDIUM","title":"ddflow/surfaces/mcp_heartbeat.py:35"}],"chunks_total":3,"coverage":"3/3 chunk(s) reviewed","delta_rounds":0,"diff_chars":9277,"diff_sha":"7acf8ab5a215d0f24ae93d97156cf7473945ebcf5ac4d1189075019166061c9b","diff_source":"main..HEAD + tracked working-tree changes in [REDACTED:path]","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":466.6,"excluded_bytes":2523,"excluded_files":1,"excluded_paths":["README.md"],"family":"deepseek","findings":2,"max_chunk_chars":5000,"model":"deepseek-ai/DeepSeek-V4-Pro-0813-Godzila","output_digest":"b428c1d55ea9e7db","output_file":".ddflow/local/reviews/fix-B7b3b4cf483.rubber_duck.lan-deepseek-v4-pro.20261022T102452Z-82aed59d.jsonl","reason":"","review_kind":"full","reviewed":[1,2,3],"reviewed_head":"33621dd13731d22a278b54939c5fe7fbcacf46ba","reviewed_paths":{"README.md":"100644 990b14db5c48952685b7a61db4577744fade4041","ddflow/config_sections/mcp.py":"100644 fb34c9f0ad155598de430235d15e81388fe9c28c","ddflow/surfaces/mcp.py":"100644 33be68b4e8f92d06dcfe5848116ca087cde09bc7","ddflow/surfaces/mcp_heartbeat.py":"100644 87eaae7e836c1ba85c0c7eb7ee712d1129c9e356","ddflow/templates/upgrade/unreleased/knob_added.mcp.progress_s.toml":"100644 f01807b6022d15bca03c09fd7f07a109ecd2ae7c","tests/test_mcp_progress_all.py":"100644 237d68a294a7677bfc4f54db9cce7f591f214789"},"reviewer":"lan-deepseek-v4-pro","reviewer_digest":"dd08c1466c2b8632","round":1,"rounds":1,"status":"REVIEWED","titles":["ddflow/surfaces/mcp.py:_progress (shared with heartbeats)","ddflow/surfaces/mcp_heartbeat.py:35"],"tree_sha":"33621dd13731+clean","unreviewed":[],"waves":1},"gate":"rubber_duck","reason":"2 finding(s)"},"id":"e1ba961c83cfdac7e96e66343","kind":"gate.failed","lamport":91173,"schema":1,"subject":"fix-B7b3b4cf483","ts":"2026-10-22T10:32:39.144190Z"}
