 with max_parallel_tasks=1 can never offer below 1 anyway"}],"refuted":1,"rounds":2},"reason":"","review_kind":"full","reviewed":[1,2,3,4,5],"reviewed_head":"102e8fdb77125ed83917ad6f761ba923c8cd64c9","reviewed_paths":{"README.md":"100644 e891490635a972a7dc7c3c66661a3488731554e3","ddflow/config_sections/schedule.py":"100644 373e559325bd41bf06fbe8f94f0b53aa327f3fb4","ddflow/core/flowparams.py":"100644 0984fa467427a1c1c4a87ed8beff6bf129d2cfbb","ddflow/core/schedule/_parallel.py":"100644 ff94ba2b17ec8f7101184ea28f03c2c464b9ba23","ddflow/services/flowstate.py":"100644 9339f2dc97a1da3a7ead15c41d812d78010aa026","ddflow/services/ticks.py":"100644 a64a24d56aa9e7c4bb251a67bc2120362df8da8a","tests/test_adaptive_config.py":"100644 cb6c914768a01d37f9e800a02fffd9596ea46774","tests/test_doctor_flow_history.py":"100644 df4c617cc940edf66b463299aa6914b18a2de569","tests/test_fixed_governor.py":"100644 9ce0274001e0b9d65210cb3bfcc7edd98d589b33","tests/test_flowstate.py":"100644 3c64ec0f8f4afc09bb9b2dc2a705a196e1d4fe12","tests/test_local_ticks.py":"100644 4d62e8aed71ba9fb8d91b764e707bb187b47d61c"},"reviewer":"lan-deepseek-v4-pro","reviewer_digest":"dd08c1466c2b8632","round":1,"rounds":1,"status":"REVIEWED","titles":["ddflow/core/flowparams.py:params"],"tree_sha":"102e8fdb7712+clean","unreviewed":[],"waves":1},"gate":"rubber_duck","reason":""},"id":"edbec86cb65f77eb23f90f6ae","kind":"gate.passed","lamport":136463,"schema":1,"subject":"fix-Bd07c080a0c","ts":"2026-11-04T19:59:07.656367Z"}
