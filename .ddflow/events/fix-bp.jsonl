"load_per_core\"`). `SIG.FakeSource` returns the keys it is given; it does not translate `\"load\"` into `\"load_per_core\"`. With no `load_per_core` sample ever recorded, `current_limit` cannot lower the fixed ceiling from 16, so `d.limit < cfg.schedule.max_parallel_tasks` and `d.limited_by == \"load_per_core\"` fail.","digest":"794ed72ab611f159","location":"tests/test_fixed_governor.py:24","severity":"HIGH","title":"tests/test_fixed_governor.py:24"}],"chunks_total":5,"coverage":"5/5 chunk(s) reviewed","delta_rounds":0,"diff_chars":18820,"diff_sha":"d45e1f1070520cfab6a6a570e530452c24acaf8412e698992af02a4614ff1d3e","diff_source":"main..HEAD + tracked working-tree changes in [REDACTED:path]","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":366.0,"excluded_bytes":2273,"excluded_files":1,"excluded_paths":["README.md"],"family":"deepseek","findings":3,"max_chunk_chars":5000,"model":"deepseek-ai/DeepSeek-V4-Pro-0813-Godzila","output_digest":"145284df13d832f4","output_file":".ddflow/local/reviews/fix-Bd07c080a0c.critic.lan-deepseek-v4-pro.20261104T195939Z-453b0349.jsonl","passed_on_refutation":{"confirmed":0,"max_rounds":6,"refutations":[{"digest":"bf6154436eeba2c9","finding":1,"probe":"FP.params(fixed tasks=1 min=2).bounds()==(1,1,1): Params.bounds() clamps floor=min(max(1,floor),ceiling), so the effective range is 1..1, identical to before; fixed=1 can never offer below 1."},{"digest":"9de1d377881d8f63","finding":2,"probe":"_words is signal.replace('_',' ') (no dict lookup, no KeyError); current_limit in fixed mode returns the fold's limited_by (mode='fixed'), never LIMIT_UNAVAILABLE (that only comes from limit_for's fallback where mode='start', which does not take the fixed branch)."},{"digest":"794ed72ab611f159","finding":3,"probe":"tests/test_fixed_governor.py::test_fixed_mode_spiked_load_lowers_the_tended_limit: SPIKED uses the 'load' key; flowstate._sample_if_due runs SIG.controller_signals(raw) which maps 'load'->'load_per_core', so the ring stores load_per_core=2.0 and current_limit lowers 16->9 limited_by=load_per_core."}],"refuted":3,"rounds":1},"reason":"","review_kind":"full","reviewed":[1,2,3,4,5],"reviewed_head":"102e8fdb77125ed83917ad6f761ba923c8cd64c9","reviewed_paths":{"README.md":"100644 e891490635a972a7dc7c3c66661a3488731554e3","ddflow/config_sections/schedule.py":"100644 373e559325bd41bf06fbe8f94f0b53aa327f3fb4","ddflow/core/flowparams.py":"100644 0984fa467427a1c1c4a87ed8beff6bf129d2cfbb","ddflow/core/schedule/_parallel.py":"100644 ff94ba2b17ec8f7101184ea28f03c2c464b9ba23","ddflow/services/flowstate.py":"100644 9339f2dc97a1da3a7ead15c41d812d78010aa026","ddflow/services/ticks.py":"100644 a64a24d56aa9e7c4bb251a67bc2120362df8da8a","tests/test_adaptive_config.py":"100644 cb6c914768a01d37f9e800a02fffd9596ea46774","tests/test_doctor_flow_history.py":"100644 df4c617cc940edf66b463299aa6914b18a2de569","tests/test_fixed_governor.py":"100644 9ce0274001e0b9d65210cb3bfcc7edd98d589b33","tests/test_flowstate.py":"100644 3c64ec0f8f4afc09bb9b2dc2a705a196e1d4fe12","tests/test_local_ticks.py":"100644 4d62e8aed71ba9fb8d91b764e707bb187b47d61c"},"reviewer":"lan-deepseek-v4-pro","reviewer_digest":"dd08c1466c2b8632","round":1,"rounds":1,"status":"REVIEWED","titles":["ddflow/core/flowparams.py:floor=s.max_parallel_min","ddflow/core/schedule/_parallel.py:_parallel_line","tests/test_fixed_governor.py:24"],"tree_sha":"55c962beb74b+clean","unreviewed":[],"waves":1},"gate":"critic","reason":""},"id":"e337699e47248dea43fee39cd","kind":"gate.passed","lamport":136508,"schema":1,"subject":"fix-Bd07c080a0c","ts":"2026-11-04T20:09:47.350940Z"}
