as/zcode-glm.md":"100644 55bfd168179d8b8ad38e92d23cca77f5c838b5bf","ddflow/templates/prompts/help/config.md":"100644 609da84d6d7c7ad78d756d52a99e31c86bf50faa","ddflow/templates/upgrade/unreleased/zcode_suspended.toml":"100644 8cbb98aa521ba15c579278e869e0751c0a52191b","docs/guide/adoption.md":"100644 e7f2fccddffb52fd27e129c1d0035d171a925a6b","tests/golden/__snapshots__/test_golden_cli_help.ambr":"100644 d352f0c59e6bec17999ac397a9603117da7399f9","tests/golden/__snapshots__/test_golden_mcp_tools.ambr":"100644 d985cce5d14ba0a4b055c4e2159fe94467f211d7","tests/golden/__snapshots__/test_golden_outputs.ambr":"100644 4bb8fd295ef619210010872fa1379b6a8ec7dd95","tests/test_adopt.py":"100644 2dfb35e0e7e03b5e50ce846f988069c6462313ee","tests/test_declared_commands.py":"100644 16e9fb5d96ae827571f872b7f01794fd53f2e508","tests/test_harness_registry.py":"100644 6cb82507eb8be37622b3fa0750b3033d8a8eedb2","tests/test_harness_suspended.py":"100644 7c4ab292b597878b575329a1f92d21bf78a22463","tests/test_remedy_texts.py":"100644 a2694c4d2d083ede8329a12a86508e11150ca3ed","tests/test_roborev_findings.py":"100644 02c0b59ad2542fad5b3f4d585e4354e6c4ddbd67"},"tree_sha":"c4e001b8cdb8+clean"},"gate":"implement","reason":""},"id":"eeac8d682345773217bdb923d","kind":"gate.passed","lamport":199812,"schema":1,"subject":"ZC-suspend","ts":"2026-11-14T12:17:13.091330Z"}
