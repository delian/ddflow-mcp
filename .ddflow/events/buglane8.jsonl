{"agent":"buglane8","data":{"by":"Qwen/Qwen3.8-Flash-Next-FP8","evidence":{"chunk_findings":[{"chunk":1,"detail":"The new detail capture identifies hook boundaries by matching `_HOOK_LINE` against `line.strip()`, so any indented line inside a failing hook’s arbitrary output that happens to end in `Passed`/`Failed`/`Skipped` after at least three dots is treated as the next pre-commit hook line. For example, given a report where gitleaks’ own output contains an indented line such as:\n\n```text\ngitleaks.......Failed\n  nested...Failed\nfinding: secret in file.txt\n```\n\nthe parser sees `nested...Failed` as a hook boundary, sets `gitleaks.detail` to `\"\"`, and appends a bogus failed check named `nested`; the actual failure tail is then attributed to the bogus check or ignored. This defeats the stated goal of keeping the failing hook’s output tail and can make `ci.result` report extra failed checks.","digest":"80bd3147b307829e","family":"alibaba","location":"ddflow/services/ci/runner.py:parse_checks","malformed":"","reviewer":"[REDACTED:name]","severity":"MEDIUM","title":"ddflow/services/ci/runner.py:parse_checks"}],"chunks_total":1,"coverage":"1/1 chunk(s) reviewed","delta_rounds":0,"diff_chars":3779,"diff_sha":"88706c412502ca7f43405461cf874ab5accd5d8a86109ebb2ae92031e87fe05b","diff_source":"main..HEAD + tracked working-tree changes in $HOME/src/ddflow/.ddflow/worktrees/fix-B-post-merge-ci-failure-carries-no-detail","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":1.2,"family":"alibaba","findings":1,"max_chunk_chars":12000,"model":"[REDACTED:name]","output_digest":"2c2e298b7a1b7d70","output_file":".ddflow/local/reviews/fix-B-post-merge-ci-failure-carries-no-detail.rubber_duck.gemini-3.5-flash-lite.20261113T114615Z-6484650a.jsonl","reason":"","review_kind":"full","reviewed":[1],"reviewed_head":"2ad9294aaba1cd088ddacefb72d21b2bcd6bcbe0","reviewed_paths":{"ddflow/services/ci/runner.py":"100644 516300f77ab694980f183d1ed4fbd3e2716eee6b","tests/test_ci_main_check.py":"100644 ac693b741f44e27fc2ef16c83335b6704d404c5d"},"reviewer":"[REDACTED:name]","reviewer_digest":"3926c0df5644d7de","reviewer_families":["alibaba","google"],"round":1,"rounds":1,"status":"REVIEWED","titles":["ddflow/services/ci/runner.py:parse_checks"],"tree_sha":"2ad9294aaba1+clean","unreviewed":[],"waves":1},"gate":"rubber_duck","reason":"1 finding(s)"},"id":"e4622c7e77b4e3ec66a9a358b","kind":"gate.failed","lamport":193158,"schema":1,"subject":"fix-B-post-merge-ci-failure-carries-no-detail","ts":"2026-11-13T11:46:17.025177Z"}
