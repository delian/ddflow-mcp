{"agent":"pswarm1","data":{"by":"grok-4.7","evidence":{"chunk_findings":[{"chunk":1,"detail":"The note is not wording-only: `reserved_in_force` is now called with the tree cap, so the “one always stays ordinary” clamp (the `force != wanted` branch) runs against `worktree.max_parallel` instead of the flight limit that enforcement still uses. With reserved/wanted 2, limit 8, worktree enabled and `max_parallel` 2, the flight share is 2 (2 ≤ 8−1) so both trees are reserved, but `reserved_in_force(2, 2)` is 1 and the summary becomes “1 of 2 worktree slot(s) reserved (2 set; one always stays ordinary)”. That claims a free ordinary tree that `open_slots` does not leave. The new test only covers wanted 1, where both caps yield force 1, so it never sees the lie.","digest":"903a3361cb0f028d","family":"xai","location":"ddflow/core/schedule/_reserved.py:136","reviewer":"grok-4.7","severity":"MEDIUM","title":"ddflow/core/schedule/_reserved.py:136"}],"chunks_total":1,"combined_gates":["rubber_duck","critic"],"coverage":"1/1 chunk(s) reviewed","delta_rounds":0,"diff_chars":2385,"diff_sha":"31f8622cd05cf0dc686e1319114f47f9d25c28e99c04a153cd128d4e70d96944","diff_source":"main..HEAD + tracked working-tree changes in $HOME/src/ddflow/.ddflow/worktrees/DX-reserved-note-tree","diff_stat":{"deletions":0,"files":0,"insertions":0,"untracked":0},"elapsed_s":107.9,"family":"xai","findings":1,"max_chunk_chars":8000,"model":"grok-4.7","output_digest":"4cfa3e9f089137f7","output_file":".ddflow/local/reviews/DX-reserved-note-tree.rubber_duck.grok-4.7.20261109T224901Z-507814e3.jsonl","reason":"","review_degraded":[{"at":1794264541.4810169,"family":"google","gate":"rubber_duck","model":"gemini-3.5-flash-lite","reason":"HTTP 429","reviewer":"gemini-3.5-flash-lite"}],"review_id":"ad8229e296c6","review_kind":"full","reviewed":[1],"reviewed_head":"ef79385ad0efcc2cf1d32bc8d421fd0335ba057a","reviewed_paths":{"ddflow/core/schedule/_reserved.py":"100644 07d14bd1261d42f229af891d6c10badc66aca0d4","tests/test