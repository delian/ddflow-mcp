{"agent":"padp-kilo","data":{"digest":"766dfe2231bc9885","finding":3,"gate":"rubber_duck","location":"ddflow/adapters/tools.py:TableTool.run","probe":"python3 -c \"python -c 'from ddflow.adapters.tool_types import RunResult, ToolSpec; from ddflow.adapters.tools import TableTool; calls=[0]; r=lambda argv,timeout_s,cwd=None:(calls.__setitem__(0,calls[0]+1) or RunResult(False,None,kind=\\\"timeout\\\",reason=\\\"probe timed out\\\")); t=TableTool(ToolSpec(\\\"x\\\",(\\\"x\\\",\\\"run\\\"),(\\\"x\\\",\\\"version\\\"),pin=\\\"2.0\\\",finding_codes=(1,)), r); t.run(); t.run(); print(\\\"probe calls after two pinned runs:\\\", calls[0])\"'","severity":"MEDIUM","title":"ddflow/adapters/tools.py:TableTool.run","verdict":"confirmed"},"id":"e77158dfa40f9ddca4d1b58c3","kind":"review.triaged","lamport":168115,"schema":1,"subject":"ADP-tools-checks","ts":"2026-11-10T22:36:42.459905Z"}
