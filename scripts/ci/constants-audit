#!/usr/bin/env python3
"""List the tunable module-level constants and fail on a new unclassified one.

    scripts/ci/constants-audit            # report; exit 1 if the register and code disagree

The register is docs/ddflow/constants-exemptions.toml (D-everything-configurable rule 6);
the logic is ddflow/services/constants_audit.py, shared with tests/test_constants_ratchet.py.
"""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))

from ddflow.services import constants_audit as ca  # noqa: E402

found = ca.scan(ROOT)
print(ca.report(ROOT, found))
sys.exit(1 if ca.problems(ca.audit(ROOT, found)) else 0)
