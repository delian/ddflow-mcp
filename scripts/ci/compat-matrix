#!/usr/bin/env python3
"""The compatibility matrix's release fixtures (B-uni-compat-tests; decision D-compat).

    scripts/ci/compat-matrix build [VERSION ...]     # default: every RELEASES entry + current

For each version: build its wheel from the release commit (ddflow is not on a package index,
so the wheel is built from `git archive` of the commit that released it), install it in a
throwaway venv, run SCENARIO with it in a fresh git repository, and commit under
tests/fixtures/releases/<version>/:

    project/        every file the scenario left tracked: the event log shards, config.toml,
                    the files `adopt` wrote, the merged code
    expected.json   what THAT release folds its own log into (tests/compat/projection.py
                    run under the old wheel) -- the answer the current release must agree with
    meta.json       version, the commit built, the python it ran on

`current` is HEAD of this checkout, recorded under its declared __version__: rebuild it when a
release is cut, and add the release to RELEASES so it stays in the matrix.

Hermetic on purpose: PYTHONPATH unset (an agent environment's `PYTHONPATH=:` would put the
working directory -- a source tree -- ahead of the wheel), DDFLOW_* unset, HOME and git
identity private to the run. Timestamps and ids are whatever the release minted; the fixture
is generated once and committed, never regenerated by the tests.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
OUT = ROOT / "tests" / "fixtures" / "releases"
PROJECTION = ROOT / "tests" / "compat" / "projection.py"

#: Released versions in the matrix (D-compat): the first public one, then one per stretch of
#: format change. `current` is added unless versions are named on the command line.
RELEASES = ("0.1.3", "0.1.10", "0.1.15", "0.1.18")

ALICE, BOB = "fx-alice", "fx-bob"
BUILD_ROOT = Path("/tmp/ddflow-compat")
UV = shutil.which("uv") or "uv"


def sh(cmd: list[str], *, cwd: Path, env: dict[str, str], check: bool = True) -> str:
    proc = subprocess.run(cmd, cwd=cwd, env=env, capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise SystemExit(
            f"$ {' '.join(cmd)}  (in {cwd})\nexit {proc.returncode}\n{proc.stdout}\n{proc.stderr}"
        )
    return proc.stdout


def release_commit(version: str) -> str | None:
    """The commit that released ``version``: its tag, else the `release X` commit (the
    releases before 0.1.9 were never tagged); None when it was never released."""
    env = dict(os.environ)
    tag = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", f"v{version}^{{commit}}"],
        cwd=ROOT,
        env=env,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if tag:
        return tag
    found = subprocess.run(
        ["git", "log", "--all", "--format=%H", f"--grep=^release {re.escape(version)}$"],
        cwd=ROOT,
        env=env,
        capture_output=True,
        text=True,
    ).stdout.split()
    if len(found) > 1:
        raise SystemExit(f"{version} was released by more than one commit: {found}")
    return found[0] if found else None


def hermetic_env(home: Path, venv: Path) -> dict[str, str]:
    """Only the release under test is on PATH: an ambient ddflow (a developer's venv)
    would otherwise be what `adopt` and `hooks install` record as the launcher."""
    env = {
        k: v
        for k, v in os.environ.items()
        if not k.startswith(("DDFLOW_", "GIT_", "VIRTUAL_ENV", "PYTHON"))
    }
    env.update(
        PATH=os.pathsep.join([str(venv / "bin"), str(Path(UV).parent), "/usr/bin", "/bin"]),
        HOME=str(home),
        USER="fixture",
        LOGNAME="fixture",
        XDG_CONFIG_HOME=str(home / ".config"),
        XDG_CACHE_HOME=str(home / ".cache"),
        GIT_AUTHOR_NAME="Fixture",
        GIT_AUTHOR_EMAIL="fixture@example.invalid",
        GIT_COMMITTER_NAME="Fixture",
        GIT_COMMITTER_EMAIL="fixture@example.invalid",
        GIT_CONFIG_NOSYSTEM="1",
        NO_COLOR="1",
        COLUMNS="100",
        # the private HOME must not cost a fresh download of every dependency
        UV_CACHE_DIR=os.environ.get("UV_CACHE_DIR") or str(Path.home() / ".cache" / "uv"),
    )
    return env


def build_wheel(commit: str, work: Path, env: dict[str, str]) -> Path:
    src = work / "src"
    src.mkdir()
    archive = subprocess.run(
        ["git", "archive", commit], cwd=ROOT, capture_output=True, check=True
    ).stdout
    subprocess.run(["tar", "-x", "-C", str(src)], input=archive, check=True)
    sh(
        ["uv", "build", "--quiet", "--wheel", "--out-dir", str(work / "dist"), str(src)],
        cwd=work,
        env=env,
    )
    (wheel,) = (work / "dist").glob("*.whl")
    return wheel


def install(wheel: Path, work: Path, env: dict[str, str]) -> Path:
    venv = work / "venv"
    sh(["uv", "venv", "--quiet", str(venv)], cwd=work, env=env)
    sh(
        ["uv", "pip", "install", "--quiet", "--python", str(venv / "bin" / "python"), str(wheel)],
        cwd=work,
        env=env,
    )
    return venv


def scenario(ddflow: Path, proj: Path, env: dict[str, str]) -> None:
    """A small project lived through: one of every record kind 0.1.3 already had, a task
    claimed, gated, merged and completed, a claim released, a split, two agents' shards."""

    def git(*args: str) -> str:
        return sh(["git", *args], cwd=proj, env=env)

    def dd(*args: str, agent: str = ALICE, cwd: Path = proj) -> str:
        return sh([str(ddflow), "--agent", agent, *args], cwd=cwd, env=env)

    proj.mkdir()
    git("init", "--quiet", "-b", "main")
    (proj / "README.md").write_text("# fixture\n")
    (proj / "src").mkdir()
    (proj / "src" / "app.py").write_text("def main():\n    return 0\n")
    git("add", "-A")
    git("commit", "--quiet", "-m", "initial")

    dd("init")
    dd("adopt", "--agents", "claude", "--launch", "uvx")
    git("add", "-A")
    git("commit", "--quiet", "-m", "adopt ddflow")

    dd("phase", "add", "P1", "--title", "Parse the input")
    dd(
        "task",
        "add",
        "T1",
        "--phase",
        "P1",
        "--title",
        "Write the parser",
        "--globs",
        "src/parser.py",
        "--tags",
        "core",
    )
    dd(
        "task",
        "add",
        "T2",
        "--phase",
        "P1",
        "--title",
        "Wire the parser into the app",
        "--needs",
        "T1",
        "--globs",
        "src/app.py",
    )
    dd(
        "task",
        "add",
        "T3",
        "--phase",
        "P1",
        "--title",
        "Document the input format",
        "--globs",
        "docs/**",
    )
    dd(
        "decision",
        "add",
        "--id",
        "D-1",
        "--title",
        "Parse with the standard library",
        "--decision",
        "No parser dependency: the input is line-based",
        "--context",
        "One input format, a dozen lines long",
        "--globs",
        "src/**",
        "--by",
        "operator",
    )
    dd(
        "lesson",
        "add",
        "--id",
        "L-1",
        "--title",
        "Strip the newline before splitting",
        "--rule",
        "Strip each line before splitting it",
        "--why",
        "A trailing newline became part of the last field",
        "--how",
        "line.rstrip('\\n').split(',')",
    )
    dd(
        "research",
        "add",
        "--question",
        "Does str.split handle an empty line?",
        "--claim",
        "''.split(',') returns ['']",
        "--falsifier",
        "it returns []",
        "--probe",
        "python -c \"print(''.split(','))\"",
        "--probe-output",
        "['']",
        "--verdict",
        "CONFIRMED",
        "--item",
        "T1",
    )
    dd("memory", "add", "Tests run with: python -m pytest -q")
    session = json.loads(
        dd("--json", "session", "start", "--model", "fixture-model", "--tool", "compat-matrix")
    )["session"]
    dd("session", "prompt", session, "--text", "Implement phase P1")

    out = dd("claim", "T1")
    tree = Path(re.search(r"worktree:\s+(\S+)", out).group(1))
    (tree / "src" / "parser.py").write_text(
        "def parse(text):\n    return [line.rstrip('\\n').split(',') for line in text.splitlines()]\n"
    )
    sh(["git", "add", "-A"], cwd=tree, env=env)
    sh(["git", "commit", "--quiet", "-m", "T1: parser"], cwd=tree, env=env)
    pipeline = re.findall(r"^\s+\[ \] (\w+)", dd("gate", "status", "T1"), re.M)
    for gate in pipeline:
        if gate == "merge":
            continue
        if gate in ("rubber_duck", "critic"):
            dd(
                "gate",
                "record",
                "T1",
                gate,
                "--outcome",
                "passed",
                "--evidence",
                "no findings",
                "--model",
                "gpt-fixture",
            )
        elif gate in ("standards", "ci"):
            dd(
                "gate",
                "record",
                "T1",
                gate,
                "--outcome",
                "unavailable",
                "--reason",
                "the fixture project has no tooling",
            )
        else:
            dd("gate", "record", "T1", gate, "--outcome", "passed", "--evidence", "fixture")
    dd("merge", "T1")
    dd("complete", "T1", "--model", "claude-fixture")

    dd("bug", "found", "--summary", "parse('') returns [] where [['']] was meant", "--item", "T1")

    dd("claim", "T3", "--no-worktree", agent=BOB)
    dd("heartbeat", "T3", agent=BOB)
    dd("release", "T3", "--note", "out of time", agent=BOB)

    dd("split", "T2", "--into", "T2.a=Call the parser", "--into", "T2.b=Report parse errors")
    dd("session", "end", session, "--summary", "P1 half done")

    git("add", "-A")
    git("commit", "--quiet", "-m", "fixture state")


def build(version: str, commit: str) -> None:
    # A FIXED neutral directory, not a fresh temp one: the release writes absolute paths into
    # what it records (session cwd, worktree paths, hook launchers), and a committed fixture
    # must name neither the machine nor the person that built it.
    work = BUILD_ROOT / version
    shutil.rmtree(work, ignore_errors=True)
    (work / "home").mkdir(parents=True)
    try:
        env = hermetic_env(work / "home", work / "venv")
        venv = install(build_wheel(commit, work, env), work, env)
        python = venv / "bin" / "python"
        declared = sh(
            [str(python), "-I", "-c", "import ddflow; print(ddflow.__version__)"], cwd=work, env=env
        ).strip()
        if declared != version:
            raise SystemExit(f"{commit[:10]} declares {declared}, not {version}")
        proj = work / "proj"
        scenario(venv / "bin" / "ddflow", proj, env)
        expected = sh([str(python), "-I", str(PROJECTION), str(proj)], cwd=work, env=env)
        python_version = sh(
            [str(python), "-I", "-c", "import sys; print(sys.version.split()[0])"],
            cwd=work,
            env=env,
        ).strip()

        dest = OUT / version
        shutil.rmtree(dest, ignore_errors=True)
        (dest / "project").mkdir(parents=True)
        for rel in sh(["git", "ls-files", "-z"], cwd=proj, env=env).split("\0"):
            if rel:
                (dest / "project" / rel).parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(proj / rel, dest / "project" / rel)
        (dest / "expected.json").write_text(expected)
        meta = {"version": version, "commit": commit, "python": python_version}
        (dest / "meta.json").write_text(json.dumps(meta, indent=1, sort_keys=True) + "\n")
        print(f"{version}: {dest.relative_to(ROOT)} ({commit[:10]})")
    finally:
        shutil.rmtree(work, ignore_errors=True)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="compat-matrix", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("build", help="(re)build release fixtures")
    b.add_argument("versions", nargs="*", help="released versions, or 'current' (default: all)")
    args = parser.parse_args(argv)
    if args.cmd == "build":
        for version in args.versions or [*RELEASES, "current"]:
            if version == "current":
                text = (ROOT / "ddflow" / "__init__.py").read_text()
                declared = re.search(r'^__version__ = "([^"]+)"', text, re.M).group(1)
                if release_commit(declared):
                    # HEAD still declares a released version: writing it to that version's
                    # directory would replace the release's fixture with unreleased code's.
                    print(f"current: HEAD declares {declared}, already released; skipped")
                    continue
                head = subprocess.run(
                    ["git", "rev-parse", "HEAD"],
                    cwd=ROOT,
                    capture_output=True,
                    text=True,
                    check=True,
                ).stdout.strip()
                build(declared, head)
            else:
                commit = release_commit(version)
                if commit is None:
                    raise SystemExit(f"cannot find the commit that released {version}")
                build(version, commit)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
