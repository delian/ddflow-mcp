{#- kilo 7.8.18 skips the model when limit has context without output, so limit is written only when both are known (a guessed output is worse than none). A lane-PRIVATE provider block for opencode and kilo (same schema). Written into the lane home, never the project. -#}
{
  "$schema": {{ schema | tojson }},
  "provider": {
    {{ provider | tojson }}: {
      "npm": "@ai-sdk/openai-compatible",
      "name": {{ name | tojson }},
      "options": {
        "baseURL": {{ base_url | tojson }}{% if api_key_env %},
        "apiKey": {{ ("{env:" ~ api_key_env ~ "}") | tojson }}{% endif %}
      },
      "models": {
        {{ model | tojson }}: {
          "name": {{ model | tojson }},
          "tool_call": {{ tool_call | tojson }}{% if window and max_output %},
          "limit": {"context": {{ window }}, "output": {{ max_output }}}{% endif %}
        }
      }
    }
  },
  "model": {{ (provider ~ "/" ~ model) | tojson }}
}
