# serializer version: 1
# name: test_every_tool_definition
  dict({
    'ddflow_brief': '''
      {
       "name": "ddflow_brief",
       "description": "START HERE every session. Returns a budgeted pack: work recoverable after a crash, the current item, what is ready to start now, why everything else is blocked, and the past lessons ranked as relevant to this task. Use this INSTEAD of reading the project's lesson or rule files: the same information, ranked for the task at hand, at a fraction of the tokens.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "item": {
          "type": "string",
          "description": "Focus on this phase or task id (optional)."
         },
         "phase": {
          "type": "string",
          "description": "Restrict the ready set to this phase (optional)."
         },
         "check_recovery": {
          "type": "boolean",
          "description": "Scan for crashed agents' worktrees and lead with them: know it BEFORE new work."
         },
         "for_agent": {
          "type": "string",
          "description": "Render this subagent's launch brief for item."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_bug': '''
      {
       "name": "ddflow_bug",
       "description": "Bug records. Set `action`; required arguments in brackets: fixed(id), invalid(id,reason), found(summary), file_tasks.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Stable id, e.g. 'B1'. You will cite it when closing."
         },
         "regression_test": {
          "type": "string",
          "description": "Test that now guards this. Several: separate with ',' or ';'."
         },
         "regression_tests": {
          "type": "array",
          "description": "The tests guarding this, one per element: the list form of regression_test.",
          "items": {
           "type": "string"
          }
         },
         "lesson_title": {
          "type": "string",
          "description": "Capture a lesson at the same time."
         },
         "lesson_rule": {
          "type": "string",
          "description": "The lesson in full: the transferable rule, not the incident."
         },
         "lesson": {
          "type": "string",
          "description": "Id of an existing lesson this bug belongs to."
         },
         "changelog": {
          "type": "string",
          "description": "Optional 'Fixed: text' (any category), or skip."
         },
         "skip_regression_verify": {
          "type": "boolean",
          "description": "Skip the pre-fix check (the test must FAIL pre-fix, PASS fixed). Needs verify_reason."
         },
         "verify_reason": {
          "type": "string",
          "description": "Why the pre-fix check is skipped (recorded); required with skip_regression_verify."
         },
         "landed": {
          "type": "string",
          "description": "A commit already on the base that holds the fix (the fix task was claimed after it landed): the test must fail on its first parent and pass on it; the fix task is ended naming it."
         },
         "lint_exempt": {
          "type": "string",
          "description": "For a CI-filed LINT bug (a check that is not a test, e.g. ruff format --check): why it needs no regression test (what made the check green). Recorded as regression_verified=exempt-lint; instead of regression_test."
         },
         "mutation": {
          "type": "string",
          "description": "Test-only fix: JSON {\"file\",\"old\",\"new\"} disabling it; the test must FAIL."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         },
         "reason": {
          "type": "string",
          "description": "Why the finding is false (with reopen: why reopen)."
         },
         "evidence": {
          "type": "string",
          "description": "The probe command or test node id that showed it false."
         },
         "reopen": {
          "type": "boolean",
          "description": "Reopen the closed bug instead."
         },
         "summary": {
          "type": "string",
          "description": "What is wrong, in one line."
         },
         "item": {
          "type": "string",
          "description": "The task it was found in or affects."
         },
         "title": {
          "type": "string",
          "description": "Short headline."
         },
         "severity": {
          "type": "string",
          "description": "low|medium|high|critical."
         },
         "scope": {
          "type": "string",
          "description": "project (default) or ddflow."
         },
         "globs": {
          "type": "string",
          "description": "The fix task's files; default: the item's globs."
         },
         "no_task": {
          "type": "boolean",
          "description": "File no fix task (fixed in the same commit)."
         },
         "relation": {
          "type": "string",
          "description": "Answer to a 'possible duplicate' refusal: new | extends:ID | duplicate_of:ID | related:ID | merge_into:ID. Omit at first."
         },
         "check_only": {
          "type": "boolean",
          "description": "Dry run: write nothing, return the `candidates`."
         },
         "all": {
          "type": "boolean",
          "description": "File a fix task for EVERY open bug that has none, other agents' too. Without it and without `id`, only a preview."
         },
         "dry_run": {
          "type": "boolean",
          "description": "List what would be filed; write nothing."
         },
         "action": {
          "type": "string",
          "enum": [
           "fixed",
           "invalid",
           "found",
           "file_tasks"
          ],
          "description": "What to do; see the tool description for each action's arguments."
         }
        },
        "additionalProperties": false,
        "required": [
         "action"
        ]
       }
      }
    ''',
    'ddflow_claim': '''
      {
       "name": "ddflow_claim",
       "description": "Lease an item and create its isolated git worktree. Refuses (exit 3) if another agent holds it or an overlapping item, and names what you could take instead. NEVER steals an expired lease: a crashed agent's tree often holds finished work.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Item id to claim, or an open bug id (its fix task is claimed, filed first if none)."
         },
         "globs": {
          "type": "string",
          "description": "Comma-separated path globs this work will write."
         },
         "note": {
          "type": "string",
          "description": "What you intend to do."
         },
         "no_worktree": {
          "type": "boolean",
          "description": "Lease the item without creating a worktree. For work that is not a code change — a research or review task."
         },
         "resources": {
          "type": "string",
          "description": "Physical resources this claim holds, e.g. 'gpu:2'; they REPLACE the item's declared ones. Refused (exit 3) when live claims already use the capacity ([schedule] resources), every holder counted."
         },
         "queue": {
          "type": "boolean",
          "description": "Queue a refused request (FIFO per file)."
         },
         "break": {
          "type": "boolean",
          "description": "Break a contended, idle lease (work kept)."
         },
         "force": {
          "type": "boolean",
          "description": "Override a refusal; only to retry after `ddflow_recover` said a crashed agent's tree holds nothing. Forcing past a dependency or live lease lets two agents write one file. Recorded."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "required": [
         "id"
        ],
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_complete': '''
      {
       "name": "ddflow_complete",
       "description": "Finish an item. Refuses (exit 3) when a required gate has not passed, a phase has open tasks, or no reviewer came from a different model family than the author. Pass your own 'model'.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Item id."
         },
         "sha": {
          "type": "string",
          "description": "Commit sha this shipped as."
         },
         "model": {
          "type": "string",
          "description": "The AUTHOR's model."
         },
         "changelog": {
          "type": "string",
          "description": "Optional 'Added|Changed|Deprecated|Removed|Fixed|Security: text', or skip."
         },
         "regression_test": {
          "type": "string",
          "description": "Fix task: the test guarding its bug(s); closes them."
         },
         "mutation": {
          "type": "string",
          "description": "Test-only fix: JSON {\"file\",\"old\",\"new\"} disabling it; the test must FAIL."
         },
         "force": {
          "type": "boolean",
          "description": "Complete over unmet conditions, each recorded as overridden forever. Prefer `ddflow_gate_skip` with a reason."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "required": [
         "id"
        ],
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_gate': '''
      {
       "name": "ddflow_gate",
       "description": "Quality gates of a work item. Set `action`; required arguments in brackets: status(id), list, run(id,gate), record(id,gate,outcome), verify(id,gate), skip(id,gate,reason), ci, tests.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Item whose worktree to mutate in."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         },
         "refuted": {
          "type": "boolean",
          "description": "List the gates passed on refutation instead."
         },
         "since": {
          "type": "string",
          "description": "With refuted: since this ISO date."
         },
         "gate": {
          "type": "string",
          "description": "Gate id. Must be a command gate."
         },
         "timeout": {
          "type": "integer",
          "description": "run: seconds this run may take (at most [gates].max_run_timeout_s)."
         },
         "outcome": {
          "type": "string",
          "description": "passed | failed | unavailable | partial | skipped"
         },
         "reason": {
          "type": "string",
          "description": "Why this step does not apply HERE. 'n/a' is not a reason: the next person reads this to decide whether you were right."
         },
         "evidence": {
          "type": "string",
          "description": "What you ran and what it said. Required by some gates."
         },
         "model": {
          "type": "string",
          "description": "REVIEWER's model, e.g. 'gemini-2.5-pro'."
         },
         "reviewer_model": {
          "type": "string",
          "description": "Like `model`; says it IS the reviewer."
         },
         "reviewed_sha": {
          "type": "string",
          "description": "Commit reviewed (roborev review <sha>); must be the branch."
         },
         "command": {
          "type": "string",
          "description": "The command you ran. With `exit_code` it makes an outcome evidence; a gate in `gates.evidence_required` is rejected without them."
         },
         "exit_code": {
          "type": "string",
          "description": "That command's exit code."
         },
         "output_file": {
          "type": "string",
          "description": "Path to its full output; a digest is recorded."
         },
         "approval": {
          "type": "string",
          "description": "An operator approval id (Q...) for this exact override; a refusal names it."
         },
         "op": {
          "type": "string",
          "description": "ci: run | status (default)."
         },
         "ref": {
          "type": "string",
          "description": "Commit to check (run)."
         },
         "base": {
          "type": "string",
          "description": "Compare against this ref instead of the item's base."
         },
         "full": {
          "type": "boolean",
          "description": "Whole suite (run)."
         },
         "item": {
          "type": "string",
          "description": "The item whose worktree and base to use."
         },
         "action": {
          "type": "string",
          "enum": [
           "status",
           "list",
           "run",
           "record",
           "verify",
           "skip",
           "ci",
           "tests"
          ],
          "description": "What to do; see the tool description for each action's arguments."
         }
        },
        "additionalProperties": false,
        "required": [
         "action"
        ]
       }
      }
    ''',
    'ddflow_heartbeat': '''
      {
       "name": "ddflow_heartbeat",
       "description": "Renew the lease on an item. Call periodically during long work, or the lease expires and another agent may take the item.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Item id."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_help': '''
      {
       "name": "ddflow_help",
       "description": "What ddflow IS, what it can do, and what the workflow is. Call this first if you have not used it before: the other descriptions explain one tool each and the connection instructions describe THIS repository; neither answers 'how am I meant to work here'. No argument: the loop from picking work to landing it, the exit codes, and every capability grouped by purpose. `topic`: workflow, import, gates, parallel, memory, recovery, config. Read-only; the pages are templates a project may override.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "topic": {
          "type": "string",
          "description": "workflow | import | gates | parallel | memory | recovery | config. Omit for the overview, which lists them."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_identify': '''
      {
       "name": "ddflow_identify",
       "description": "Declare WHO you are on this connection before anything that writes. Call it first when 2+ agents or subagents work this repository at once: identity attributes every claim, gate outcome and review, and the tree-derived default merges several agents in one tree into one identity with no error (a review would pass independence against itself). Pick a short stable name (your role), distinct from the others'. Idempotent. A SUBAGENT sharing its parent's connection must NOT call this; it passes `as_agent` on each call instead (the CLI's `--agent`). Stateless 2026-07-28 requests: persists nothing; name yourself per call (as_agent or _meta ddflow/agent).",
       "inputSchema": {
        "type": "object",
        "properties": {
         "agent": {
          "type": "string",
          "description": "A short stable name, e.g. 'reviewer-2' (letters, digits, . _ -; max 64; it names your log file). OMIT to reset to the tree-derived default."
         }
        },
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_memory': '''
      {
       "name": "ddflow_memory",
       "description": "Lessons, memories, recall and record links. Set `action`; required arguments in brackets: lesson_verify, lesson_add(title), lesson_search(query), recall(query), similar(text), dupes, link(subject,relation,target), add(text), list, forget(id,reason).",
       "inputSchema": {
        "type": "object",
        "properties": {
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         },
         "id": {
          "type": "string",
          "description": "Stable id you choose. Referenced by `supersedes`, by commit messages and by the reconstruction; a generated id cannot be cited in advance."
         },
         "title": {
          "type": "string",
          "description": "The rule as a one-line statement."
         },
         "rule": {
          "type": "string",
          "description": "The rule in full."
         },
         "why": {
          "type": "string",
          "description": "Why it is true / what went wrong."
         },
         "how": {
          "type": "string",
          "description": "How to apply or detect it."
         },
         "summary": {
          "type": "string",
          "description": "The lesson in ONE paragraph, for a reader who will not open the full rule. Rendered into docs/ddflow/LESSONS-SUMMARY.md."
         },
         "tags": {
          "type": "string",
          "description": "Comma-separated tags, e.g. 'gpu,machine'."
         },
         "seen_in": {
          "type": "string",
          "description": "Comma-separated item ids where this was hit. What makes a lesson checkable later instead of merely memorable."
         },
         "supersedes": {
          "type": "string",
          "description": "Comma-separated lesson ids this replaces. The old one is retired, not deleted: the corpus stops growing without losing what was once believed."
         },
         "pattern": {
          "type": "string",
          "description": "A regex naming the mistake in CODE. Scans now and stores WHICH sites match, so `ddflow_lesson_verify` can name those that reappear. Prefer it to a remembered rule when mechanical: a count says 'worse', never 'which'. Refused if it does not compile."
         },
         "globs": {
          "type": "string",
          "description": "Comma-separated globs to scan for `pattern`. Default: every tracked file."
         },
         "relation": {
          "type": "string",
          "description": "Answer to a 'possible duplicate' refusal: new | extends:ID | duplicate_of:ID | related:ID | merge_into:ID. Omit at first."
         },
         "check_only": {
          "type": "boolean",
          "description": "Dry run: write nothing, return the `candidates`."
         },
         "query": {
          "type": "string",
          "description": "Rank by relevance to this instead of by recency."
         },
         "limit": {
          "type": "integer",
          "description": "At most this many (default: all)."
         },
         "max_chars": {
          "type": "integer",
          "description": "Total budget for the answer. The point of a budget is that recall is called at the START of work, where a long answer costs the context the work itself needs."
         },
         "sources": {
          "type": "string",
          "description": "Comma-separated subset: decisions,lessons,memories,research,bugs,items,prompts. Default: all."
         },
         "text": {
          "type": "string",
          "description": "The title or summary of the record you are about to file."
         },
         "kind": {
          "type": "string",
          "description": "Comma-separated subset of the configured kinds to look in: bug,task,phase,lesson,decision,research,memory. Default: all of them."
         },
         "item": {
          "type": "string",
          "description": "Only the pairs this record is in."
         },
         "open_only": {
          "type": "boolean",
          "description": "Only pairs where both records are still live (the dedupe_sweep pass)."
         },
         "floor": {
          "type": "number",
          "description": "Minimum score to report (default: [dedupe].show_floor)."
         },
         "subject": {
          "type": "string",
          "description": "The record being related (the duplicate, for a merge)."
         },
         "target": {
          "type": "string",
          "description": "The record it is related to."
         },
         "reason": {
          "type": "string",
          "description": "Why, recorded with the link."
         },
         "all": {
          "type": "boolean",
          "description": "Include forgotten memories, with why they were forgotten."
         },
         "action": {
          "type": "string",
          "enum": [
           "lesson_verify",
           "lesson_add",
           "lesson_search",
           "recall",
           "similar",
           "dupes",
           "link",
           "add",
           "list",
           "forget"
          ],
          "description": "What to do; see the tool description for each action's arguments."
         }
        },
        "additionalProperties": false,
        "required": [
         "action"
        ]
       }
      }
    ''',
    'ddflow_merge': '''
      {
       "name": "ddflow_merge",
       "description": "Land an item's branch without ever switching a checkout's branch. With [flow].integration = 'pr' it pushes and opens (or updates) a pull request instead, releases your lease and parks the item in REVIEW — take the next item; `ddflow_pr_sync` completes it once a person merges it.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Item id."
         },
         "message": {
          "type": "string",
          "description": "Merge commit message."
         },
         "queue": {
          "type": "boolean",
          "description": "Enqueue (ddflow_queue add) instead of landing."
         },
         "keep": {
          "type": "boolean",
          "description": "Keep the worktree after merging, for inspection."
         },
         "model": {
          "type": "string",
          "description": "The AUTHOR's model. In PR mode the item completes at `ddflow_pr_sync`, which needs it for reviewer independence."
         },
         "allow_dirty": {
          "type": "boolean",
          "description": "Merge although the worktree is dirty; uncommitted changes are NOT included. Only once you know it is build output."
         },
         "allow_empty": {
          "type": "boolean",
          "description": "Land a branch with no commits ahead of its target (refused by default: usually the wrong tree; rebind with ddflow_update worktree)."
         },
         "branch": {
          "type": "string",
          "description": "no_worktree items: the branch to land (default: the one checked out where this runs). Changes outside the item's globs come back as outside_globs."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "required": [
         "id"
        ],
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_next': '''
      {
       "name": "ddflow_next",
       "description": "What may be started RIGHT NOW, and for everything that may not, the reason. Independent items in the ready set can be run in parallel worktrees by separate agents. Returns ready=[] when nothing is actionable — that is a result, not an error, and it never means 'pick something anyway'.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "phase": {
          "type": "string",
          "description": "Restrict to one phase (the 'implement phase X' entry point)."
         },
         "kind": {
          "type": "string",
          "description": "'task' (default) or 'phase'."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_session': '''
      {
       "name": "ddflow_session",
       "description": "The session log. Set `action`; required arguments in brackets: note(text), end(session), prompt(text), start.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "session": {
          "type": "string",
          "description": "Session id; omit for the latest open."
         },
         "text": {
          "type": "string",
          "description": "The prompt, verbatim."
         },
         "item": {
          "type": "string",
          "description": "Item it concerns."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         },
         "summary": {
          "type": "string",
          "description": "What this session achieved."
         },
         "model": {
          "type": "string",
          "description": "Your model id."
         },
         "tool": {
          "type": "string",
          "description": "Your harness, e.g. 'claude-code'."
         },
         "action": {
          "type": "string",
          "enum": [
           "note",
           "end",
           "prompt",
           "start"
          ],
          "description": "What to do; see the tool description for each action's arguments."
         }
        },
        "additionalProperties": false,
        "required": [
         "action"
        ]
       }
      }
    ''',
    'ddflow_show': '''
      {
       "name": "ddflow_show",
       "description": "Everything known about one phase, task, bug or research note: state, dependencies, globs, the lease holder, the worktree path, and every gate's outcome with evidence. Check your work with it before ddflow_complete.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Item, bug or research-note id."
         },
         "report": {
          "type": "boolean",
          "description": "Its completion report."
         },
         "brief": {
          "type": "boolean",
          "description": "With report: the 8-line form."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         }
        },
        "required": [
         "id"
        ],
        "additionalProperties": false
       }
      }
    ''',
    'ddflow_task': '''
      {
       "name": "ddflow_task",
       "description": "Tasks, phases and research notes. Set `action`; required arguments in brackets: phase_add(id), split(id,into), add(id), research_add(question,verdict), update(id), remove(id), resolve(id,keep), phase_close(id,imported), batch, fold(dup,keep), rename(old,new).",
       "inputSchema": {
        "type": "object",
        "properties": {
         "id": {
          "type": "string",
          "description": "Stable id you choose. Referenced by `supersedes`, by commit messages and by the reconstruction; a generated id cannot be cited in advance."
         },
         "title": {
          "type": "string",
          "description": "One-line description."
         },
         "needs": {
          "type": "string",
          "description": "Comma-separated ids it depends on. Pass an EMPTY string to clear them — that is how you break a dependency cycle the loop detector found."
         },
         "globs": {
          "type": "string",
          "description": "Path globs this item writes, comma-separated or a JSON array. REPLACES the list (a claimed item's lease too); the result names what it dropped. Empty: none, and a fix task then takes none from its bug."
         },
         "body": {
          "type": "string",
          "description": "New detail / acceptance criteria. REPLACES the body."
         },
         "tags": {
          "type": "string",
          "description": "Comma-separated tags."
         },
         "priority": {
          "type": "integer",
          "description": "Lower is offered first (default 100; a DX or bug-fix task: its band)."
         },
         "line": {
          "type": "string",
          "description": "Release line this lands on (a name from [flow.lines], or the current line). Omit for the current line; tasks inherit a phase's line."
         },
         "readd": {
          "type": "boolean",
          "description": "File a REMOVED item's id again with this definition. An id still in the queue is always refused -- change that item with ddflow_update."
         },
         "relation": {
          "type": "string",
          "description": "Answer to a 'possible duplicate' refusal: new | extends:ID | duplicate_of:ID | related:ID | merge_into:ID. Omit at first."
         },
         "check_only": {
          "type": "boolean",
          "description": "Dry run: write nothing, return the `candidates`."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         },
         "into": {
          "type": "string",
          "description": "Comma-separated 'sub-id=title' pairs. At least two."
         },
         "phase": {
          "type": "string",
          "description": "Owning phase id. Give this OR `parent`."
         },
         "parent": {
          "type": "string",
          "description": "Move the task under this phase (or task); empty makes it top level. Refused for a finished item, a missing parent, or a dependency cycle."
         },
         "resources": {
          "type": "string",
          "description": "Physical resources the work RUNS on, beside its files: 'gpu:4,vllm-fleet'. `next` withholds and `claim` refuses while live claims use up the capacity ([schedule] resources). Declare for a GPU job, model server or long run. Empty clears."
         },
         "lines": {
          "type": "string",
          "description": "Release lines a FIX must reach, e.g. '1,2,3': written where [flow].port_strategy says, plus a port task `<id>@<line>` per other line."
         },
         "port_of": {
          "type": "string",
          "description": "Earlier fix this follows up: reuses the lines it reached."
         },
         "question": {
          "type": "string",
          "description": "What was asked."
         },
         "verdict": {
          "type": "string",
          "description": "CONFIRMED | REFUTED | THEORETICAL"
         },
         "claim": {
          "type": "string",
          "description": "The falsifiable claim."
         },
         "falsifier": {
          "type": "string",
          "description": "The single observation that would kill it."
         },
         "probe": {
          "type": "string",
          "description": "The command you ran."
         },
         "probe_output": {
          "type": "string",
          "description": "Its output, verbatim."
         },
         "sources": {
          "type": "string",
          "description": "Comma-separated URLs/DOIs you actually opened."
         },
         "mechanism": {
          "type": "string",
          "description": "WHY it would work in this repo. The middle field of the triple — claim, mechanism, falsifier — and the one most often skipped."
         },
         "budget": {
          "type": "string",
          "description": "What you allowed yourself, e.g. '30 min, no GPU'."
         },
         "item": {
          "type": "string",
          "description": "The task this research is for."
         },
         "append_body": {
          "type": "string",
          "description": "Text to ADD after the item's current body (a blank line between); the original is kept. Use it for a note or a decision instead of re-sending the body."
         },
         "queue": {
          "type": "boolean",
          "description": "Queue a refused request (FIFO per file)."
         },
         "landed": {
          "type": "string",
          "description": "Record work already on main: a commit, or <before>..<after>; verified as ancestors of the base touching the item's globs. For work merged outside `ddflow merge`."
         },
         "kind": {
          "type": "string",
          "description": "Work kind: task, doc, research or job (its gate pipeline)."
         },
         "worktree": {
          "type": "string",
          "description": "Rebind the item and your live lease to this linked worktree (absolute, or repo-relative) and its branch: the way out of a wrong-tree binding, since re-claiming keeps the recorded tree and merge lands that tree's branch."
         },
         "reason": {
          "type": "string",
          "description": "Why (recorded on the abandonment)."
         },
         "force": {
          "type": "boolean",
          "description": "Remove although it still has open children or dependents. Both leave the queue inconsistent in a way the scheduler reports; read the refusal before overriding."
         },
         "keep": {
          "type": "string",
          "description": "Event id (or a 6+ character prefix), agent, or lease holder to keep."
         },
         "refile_as": {
          "type": "string",
          "description": "Comma-separated new ids, one per definition NOT kept, in `show` order: each is re-added under its new id in the same transaction."
         },
         "imported": {
          "type": "boolean",
          "description": "Required: closes an IMPORTED phase; its imported source is the evidence recorded."
         },
         "edits": {
          "type": "string",
          "description": "JSON array of edit objects, each with an 'id'."
         },
         "dry_run": {
          "type": "boolean",
          "description": "Plan and show the diff; record nothing."
         },
         "dup": {
          "type": "string",
          "description": "The duplicate to abandon."
         },
         "old": {
          "type": "string",
          "description": "The task to rename."
         },
         "new": {
          "type": "string",
          "description": "Its new id."
         },
         "action": {
          "type": "string",
          "enum": [
           "phase_add",
           "split",
           "add",
           "research_add",
           "update",
           "remove",
           "resolve",
           "phase_close",
           "batch",
           "fold",
           "rename"
          ],
          "description": "What to do; see the tool description for each action's arguments."
         }
        },
        "additionalProperties": false,
        "required": [
         "action"
        ]
       }
      }
    ''',
    'ddflow_view': '''
      {
       "name": "ddflow_view",
       "description": "Read the queue, history and reports. Set `action`; required arguments in brackets: queue, board, progress, loops, status, render, list(kind), history, cadence, pins(document), lanes, metrics, health, docs.",
       "inputSchema": {
        "type": "object",
        "properties": {
         "op": {
          "type": "string",
          "description": "queue: add|run|status (default)|remove."
         },
         "id": {
          "type": "string",
          "description": "One item, with its per-attempt detail."
         },
         "max_batch": {
          "type": "integer",
          "description": "run: max entries."
         },
         "unit_tests": {
          "type": "boolean",
          "description": "Also run unit_tests."
         },
         "timeout": {
          "type": "integer",
          "description": "run: ci seconds."
         },
         "as_agent": {
          "type": "string",
          "description": "Subagent name, this call only."
         },
         "phase": {
          "type": "string",
          "description": "Limit to one phase (and, for forecast, its critical path)."
         },
         "limit": {
          "type": "integer",
          "description": "Rows returned, most effort first (default 25; 0 = all)."
         },
         "out": {
          "type": "string",
          "description": "Directory for the generated views (default: docs/ddflow)."
         },
         "show": {
          "type": "string",
          "description": "Print ONE view instead of writing files: lessons, lessons-summary, research, or board. This is what the ddflow:// resources are served from."
         },
         "kind": {
          "type": "string",
          "description": "Comma-separated event kinds or families: 'gate', 'lease.acquired', 'decision,bug'."
         },
         "query": {
          "type": "string",
          "description": "kind=search: text to find."
         },
         "state": {
          "type": "string",
          "description": "Only this state."
         },
         "tag": {
          "type": "string",
          "description": "Only this tag."
         },
         "owner": {
          "type": "string",
          "description": "Only this agent's rows."
         },
         "since": {
          "type": "string",
          "description": "Only what happened since: a duration back from now (7d, 12h) or a date YYYY-MM-DD."
         },
         "item": {
          "type": "string",
          "description": "The item to look back on; with view=retro."
         },
         "offset": {
          "type": "integer",
          "description": "Skip this many rows (paging; a cut list says `next`)."
         },
         "all": {
          "type": "boolean",
          "description": "kind=bug|lesson: include fixed/invalid/superseded."
         },
         "mode": {
          "type": "string",
          "description": "search: ranked|exact|regex."
         },
         "sources": {
          "type": "string",
          "description": "search: comma-separated record kinds."
         },
         "source": {
          "type": "string",
          "description": "search: comma-separated search sources (default all)."
         },
         "tail": {
          "type": "integer",
          "description": "Last N entries, oldest first (overrides limit)."
         },
         "by_agent": {
          "type": "string",
          "description": "Only this agent's events."
         },
         "ran": {
          "type": "string",
          "description": "Record that this cadence just ran."
         },
         "note": {
          "type": "string",
          "description": "What the pass did, recorded with it."
         },
         "document": {
          "type": "string",
          "description": "Instruction file path; or `regenerate`."
         },
         "check": {
          "type": "boolean",
          "description": "regenerate: list stale pins only."
         },
         "only": {
          "type": "string",
          "description": "regenerate: just this pin."
         },
         "install": {
          "type": "boolean",
          "description": "regenerate: install merge driver + hook."
         },
         "after_merge": {
          "type": "boolean",
          "description": "regenerate: the post-merge hook entry."
         },
         "tests": {
          "type": "string",
          "description": "Comma-separated test dirs (default: tests,test)."
         },
         "min_needle": {
          "type": "integer",
          "description": "Shortest string literal that counts as a pin (default 12)."
         },
         "top": {
          "type": "integer",
          "description": "How many free stretches to return (default 10)."
         },
         "view": {
          "type": "string",
          "description": "summary (default), forecast, retro, skips or lanes."
         },
         "lane": {
          "type": "string",
          "description": "Lane name (or a unique part); with view=brief."
         },
         "group_by": {
          "type": "string",
          "description": "Group the outcome rates by gate (default), reviewer, agent, kind or phase."
         },
         "run": {
          "type": "boolean",
          "description": "Correct per mode."
         },
         "verb": {
          "type": "string",
          "description": "check (default)."
         },
         "diff": {
          "type": "string",
          "description": "check: a git base; report only the extracted surface added since it."
         },
         "action": {
          "type": "string",
          "enum": [
           "queue",
           "board",
           "progress",
           "loops",
           "status",
           "render",
           "list",
           "history",
           "cadence",
           "pins",
           "lanes",
           "metrics",
           "health",
           "docs"
          ],
          "description": "What to do; see the tool description for each action's arguments."
         }
        },
        "additionalProperties": false,
        "required": [
         "action"
        ]
       }
      }
    ''',
  })
# ---
# name: test_the_tool_names_in_order
  list([
    'ddflow_brief',
    'ddflow_bug',
    'ddflow_claim',
    'ddflow_complete',
    'ddflow_gate',
    'ddflow_heartbeat',
    'ddflow_help',
    'ddflow_identify',
    'ddflow_memory',
    'ddflow_merge',
    'ddflow_next',
    'ddflow_session',
    'ddflow_show',
    'ddflow_task',
    'ddflow_view',
  ])
# ---
