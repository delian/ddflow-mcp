# ---
# name: test_help[ddflow workflow gate]
  '''
  usage: ddflow workflow gate [-h] [--command COMMAND] [--prompt PROMPT] [--title TITLE] [--cwd {,worktree,repo}] [--reviewer {,different_family,same_family_ok}] [--timeout TIMEOUT] [--applies-to {,task,phase,both}] [--into {,task,phase,both}] [--after AFTER] [--required] [--dry-run] id
  
  positional arguments:
    id
  
  options:
    -h, --help            show this help message and exit
    --command COMMAND     what to run; makes it a command gate
    --prompt PROMPT       what to ask an agent; makes it an agent gate
    --title TITLE
    --cwd {,worktree,repo}
    --reviewer {,different_family,same_family_ok}
                          require a reviewer, and whether it must be a different model family
    --timeout TIMEOUT     seconds before it is unavailable
    --applies-to {,task,phase,both}
    --into {,task,phase,both}
                          add to a pipeline
    --after AFTER         place it after this gate (default: last)
    --required            an item cannot complete without it
    --dry-run             show it; write nothing
  
  '''
