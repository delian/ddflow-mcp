  usage: ddflow external [-h] {sync} ...
  
  positional arguments:
    {sync}
      sync      observe the sibling-repo items `needs` names; record what changed
  
  options:
    -h, --help  show this help message and exit
  
  '''
# ---
# name: test_help[ddflow flow choose]
  '''
  usage: ddflow flow choose [-h] [--reason REASON] knob value
  
  positional arguments:
    knob
    value
  
  options:
    -h, --help       show this help message and exit
    --reason REASON  why — the next agent reads this
  
  '''
# ---
# name: test_help[ddflow flow show]
  '''
  usage: ddflow flow show [-h]
  
  options:
    -h, --help  show this help message and exit
  
  '''
# ---
# name: test_help[ddflow flow]
  '''
  usage: ddflow flow [-h] {show,choose} ...
  
  positional arguments:
    {show,choose}
      show         every choice: value, options, and who decided
      choose       record a workflow choice (the config file still wins over it)
  
  options:
    -h, --help     show this help message and exit
  
  '''
# ---
# name: test_help[ddflow gate record]
  '''
  usage: ddflow gate record [-h] [--outcome {passed,failed,unavailable,partial,skipped}] [--reason REASON] [--evidence EVIDENCE] [--command COMMAND] [--exit-code EXIT_CODE] [--model MODEL] [--reviewer-model REVIEWER_MODEL] [--reviewed-sha REVIEWED_SHA] [--output-file OUTPUT_FILE] id gate
  
  positional arguments:
    id
    gate
  
  options:
    -h, --help            show this help message and exit
    --outcome {passed,failed,unavailable,partial,skipped}
                          failed, unavailable, partial and skipped each require --reason
    --reason REASON       why the gate did not pass; REQUIRED for outcomes failed, unavailable,
                          partial and skipped (--evidence is what you observed, not a substitute)
    --evidence EVIDENCE   what you observed: output, a summary
    --command COMMAND
    --exit-code EXIT_CODE
    --model MODEL         the REVIEWER's model, for family independence (the author's is `complete
                          --model`); an author-family name on a reviewer gate is refused
    --reviewer-model REVIEWER_MODEL
                          like --model, stating that this model IS the reviewer, so an author-family
                          name is recorded rather than refused
    --reviewed-sha REVIEWED_SHA
                          the commit the review tool ran on (roborev review <sha>); refused when it
                          is not the item's branch head or a commit of its branch
    --output-file OUTPUT_FILE
  
  '''
# ---
# name: test_help[ddflow gate run]
  '''
  usage: ddflow gate run [-h] id gate
  
  positional arguments:
    id
    gate
  
  options:
    -h, --help  show this help message and exit
  
  '''
# ---
# name: test_help[ddflow gate skip]
  '''
  usage: ddflow gate skip [-h] [--outcome {passed,failed,unavailable,partial,skipped}] [--reason REASON] [--evidence EVIDENCE] [--command COMMAND] [--exit-code EXIT_CODE] [--model MODEL] [--output-file OUTPUT_FILE] id gate
  
  positional arguments:
    id
    gate
  
  options:
    -h, --help            show this help message and exit
    --outcome {passed,failed,unavailable,partial,skipped}
                          failed, unavailable, partial and skipped each require --reason
    --reason REASON       why the gate did not pass; REQUIRED for outcomes failed, unavailable,
                          partial and skipped (--evidence is what you observed, not a substitute)
    --evidence EVIDENCE   what you observed: output, a summary
    --command COMMAND
    --exit-code EXIT_CODE
    --model MODEL         the REVIEWER's model, for family independence (the author's is `complete
                          --model`); an author-family name on a reviewer gate is refused
    --output-file OUTPUT_FILE
  
  '''
