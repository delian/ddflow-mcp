# name: test_help[ddflow search]
  '''
  usage: ddflow search [-h] [--exact | --regex] [--kind KIND] [--state STATE] [--phase PHASE] [--owner OWNER] [--since SINCE] [--limit LIMIT] query
  
  positional arguments:
    query          the text to look for
  
  options:
    -h, --help     show this help message and exit
    --exact        case-insensitive substring, not ranked
    --regex        a regular expression (unsafe ones are refused)
    --kind KIND    comma-separated sources to search (default all): task, phase, bug, research,
                   decision, lesson, session, prompt, log
    --state STATE  only hits in this state
    --phase PHASE  only hits under this phase id
    --owner OWNER  only hits by this agent (lease holder, session or event agent); not --agent,
                   which is who YOU are
    --since SINCE  only hits dated at or after this ISO date
    --limit LIMIT  most hits to show
  
  '''
