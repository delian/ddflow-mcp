  positional arguments:
    text
  
  options:
    -h, --help         show this help message and exit
    --tags TAGS
    --id ID            re-record (correct) an existing memory
    --new              answer a possible-duplicate refusal: this is a different record, file it
    --extends ID       answer it: this adds to record ID -- appended to ID while it is open and
                       unclaimed, else filed as a new record linked to it
    --duplicate-of ID  answer it: this is the same thing as record ID (handled like --extends)
    --related ID       answer it: a different record that is related to ID; linked both ways
    --check            dry run: print the existing records this would be refused as a duplicate of
                       and write nothing (exit 0 with candidates, 2 with none)
  
