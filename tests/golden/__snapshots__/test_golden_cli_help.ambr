# serializer version: 1
# name: test_help[ddflow abandon]
  '''
  usage: ddflow abandon [-h] --reason REASON [--force] id
  
  positional arguments:
    id
  
  options:
    -h, --help       show this help message and exit
    --reason REASON
    --force
  
  '''
# ---
# name: test_help[ddflow adopt]
  '''
  usage: ddflow adopt [-h] [--agents AGENTS] [--docs DOCS] [--launch {auto,uvx,docker,python}] [--image IMAGE] [--refresh-docs]
  
  options:
    -h, --help            show this help message and exit
    --agents AGENTS       comma-separated: claude,gemini,codex,copilot,vscode,kilo,cursor,kimi,openc
                          ode,glm,qwen,antigravity,devin,qodo,tabnine,aider,cline,windsurf,replit,op
                          enhands,goose,cody (default: all)
    --docs DOCS           where to write the drivers
    --launch {auto,uvx,docker,python}
                          how agents spawn the MCP server: 'auto' prefers uvx for an install from a
                          package index and this installation otherwise; 'docker' needs no Python
                          toolchain at all
    --image IMAGE         container image used by --launch docker
    --refresh-docs        rewrite ONLY the driver docs, the AGENTS.md/CLAUDE.md blocks and the
                          agents' native rules from this ddflow's templates; leaves MCP launches,
                          hooks and command files alone (what `doctor` points to when drivers lag)
  
  '''
# ---
# name: test_help[ddflow approve]
  '''
  usage: ddflow approve [-h] [--note NOTE] [--reject] [--reason REASON] id gate
  
  positional arguments:
    id
    gate
  
  options:
    -h, --help       show this help message and exit
    --note NOTE      what you looked at, for the record
    --reject         refuse it; --reason required
    --reason REASON  why it was rejected — a 'no' nobody can act on is a stall
  
  '''
# ---
# name: test_help[ddflow bisect]
  '''
  usage: ddflow bisect [-h] --cmd CMD [--candidates CANDIDATES] [--glob GLOB] [--timeout TIMEOUT] [--repeat REPEAT] [--max-runs MAX_RUNS] victim
  
  positional arguments:
    victim                the test that fails only after others ran (a test id)
  
  options:
    -h, --help            show this help message and exit
    --cmd CMD             a command that runs a list of tests and exits non-zero on failure, with
                          {tests} where the list goes, e.g. 'pytest -q {tests}'
    --candidates CANDIDATES
                          comma-separated files, in run order
    --glob GLOB           where candidates come from (default tests/**/test_*.py)
    --timeout TIMEOUT     seconds per run (default 600)
    --repeat REPEAT       runs per probe; any failure counts
    --max-runs MAX_RUNS   stop after this many runs
  
  '''
# ---
# name: test_help[ddflow block]
  '''
  usage: ddflow block [-h] --reason REASON [--reopen] id
  
  positional arguments:
    id
  
  options:
    -h, --help       show this help message and exit
    --reason REASON
    --reopen         block an item that is already DONE or ABANDONED (refused without)
  
  '''
# ---
# name: test_help[ddflow board]
  '''
  usage: ddflow board [-h] [--phase PHASE]
  
  options:
    -h, --help     show this help message and exit
    --phase PHASE
  
  '''
# ---
# name: test_help[ddflow brief]
  '''
  usage: ddflow brief [-h] [--item ITEM] [--phase PHASE] [--check-recovery]
  
  options:
    -h, --help        show this help message and exit
    --item ITEM
    --phase PHASE
    --check-recovery
  
  '''
# ---
# name: test_help[ddflow bug file-tasks]
  '''
  usage: ddflow bug file-tasks [-h] [--dry-run]
  
  options:
    -h, --help  show this help message and exit
    --dry-run   list what would be filed
  
  '''
# ---
# name: test_help[ddflow bug fixed]
  '''
  usage: ddflow bug fixed [-h] [--regression-test REGRESSION_TEST] [--skip-regression-verify] [--verify-reason VERIFY_REASON] [--lesson LESSON] [--lesson-title LESSON_TITLE] [--lesson-rule LESSON_RULE] [--changelog CHANGELOG] id
  
  positional arguments:
    id
  
  options:
    -h, --help            show this help message and exit
    --regression-test REGRESSION_TEST
                          the test that now guards this bug; repeat it, or separate with ',' or ';',
                          for several
    --skip-regression-verify
                          do not run the named test on the pre-fix tree; requires --verify-reason
                          (recorded)
    --verify-reason VERIFY_REASON
                          why the pre-fix regression check is skipped (recorded)
    --lesson LESSON
    --lesson-title LESSON_TITLE
    --lesson-rule LESSON_RULE
    --changelog CHANGELOG
                          'Fixed: text' (any category), or skip / internal
  
  '''
# ---
# name: test_help[ddflow bug found]
  '''
  usage: ddflow bug found [-h] [--id ID] --summary SUMMARY [--item ITEM] [--title TITLE] [--severity SEVERITY] [--scope SCOPE] [--globs GLOBS] [--no-task] [--new | --extends ID | --duplicate-of ID | --related ID | --check]
  
  options:
    -h, --help           show this help message and exit
    --id ID
    --summary SUMMARY
    --item ITEM
    --title TITLE        a short headline for the bug
    --severity SEVERITY  low | medium | high | critical (optional)
    --scope SCOPE        project (default), or ddflow for a bug in ddflow itself
    --globs GLOBS        the fix task's files (comma-separated); default: the item's own globs
    --no-task            file no fix task: the bug is fixed in the commit that found it
    --new                answer a possible-duplicate refusal: this is a different record, file it
    --extends ID         answer it: this adds to record ID -- appended to ID while it is open and
                         unclaimed, else filed as a new record linked to it
    --duplicate-of ID    answer it: this is the same thing as record ID (handled like --extends)
    --related ID         answer it: a different record that is related to ID; linked both ways
    --check              dry run: print the existing records this would be refused as a duplicate of
                         and write nothing (exit 0 with candidates, 2 with none)
  
  '''
# ---
# name: test_help[ddflow bug invalid]
  '''
  usage: ddflow bug invalid [-h] --reason REASON [--evidence EVIDENCE] id
  
  positional arguments:
    id
  
  options:
    -h, --help           show this help message and exit
    --reason REASON      why the finding is false
    --evidence EVIDENCE  the probe command or test node id that showed it
  
  '''
# ---
# name: test_help[ddflow bug list]
  '''
  usage: ddflow bug list [-h] [--state STATE] [--phase PHASE] [--since SINCE] [--limit LIMIT] [--all] [--item ITEM]
  
  options:
    -h, --help     show this help message and exit
    --state STATE  only rows in this state
    --phase PHASE  only rows under this phase id
    --since SINCE  only rows last changed at or after this ISO date or timestamp
    --limit LIMIT  most rows to show (default 50)
    --all          include fixed and invalid bugs
    --item ITEM    only bugs filed in or against this queue item id
  
  '''
# ---
# name: test_help[ddflow bug reopen]
  '''
  usage: ddflow bug reopen [-h] --reason REASON id
  
  positional arguments:
    id
  
  options:
    -h, --help       show this help message and exit
    --reason REASON  why the closure was wrong
  
  '''
# ---
# name: test_help[ddflow bug]
  '''
  usage: ddflow bug [-h] {found,file-tasks,fixed,invalid,reopen,list} ...
  
  positional arguments:
    {found,file-tasks,fixed,invalid,reopen,list}
      file-tasks          file a fix task for every open bug that has none (one-shot, after an
                          upgrade)
      invalid             close a bug as a FALSE finding (never as fixed), with why and the probe
      reopen              reopen a bug closed by mistake (fixed or invalid), saying why
      list                list bugs: the open ones unless --all or --state
  
  options:
    -h, --help            show this help message and exit
  
  '''
# ---
# name: test_help[ddflow cadence]
  '''
  usage: ddflow cadence [-h] [--ran RAN] [--note NOTE]
  
  options:
    -h, --help   show this help message and exit
    --ran RAN
    --note NOTE
  
  '''
# ---
# name: test_help[ddflow ci]
  '''
  usage: ddflow ci [-h] [--ref REF] [--base BASE] [--command COMMAND] [--stage STAGE] [--result {passed,failed}] [--report REPORT] [--sha SHA] [{run,status,record}]
  
  positional arguments:
    {run,status,record}   run: check the merge result; status (default): what would run, and whether
                          it can
  
  options:
    -h, --help            show this help message and exit
    --ref REF             run: the commit or item id (default: HEAD here)
    --base BASE           run: merge this branch in first (default [ci].base)
    --command COMMAND     run: use this instead of [ci].command
    --stage STAGE         record: gate | merge | pre-push | schedule
    --result {passed,failed}
                          record: how it went
    --report REPORT       record: file with the pre-commit output, parsed for the failing checks
    --sha SHA             record: the commit that was checked
  
  '''
# ---
# name: test_help[ddflow claim]
  '''
  usage: ddflow claim [-h] [--globs GLOBS] [--note NOTE] [--force] [--no-worktree] [--resources RESOURCES] id
  
  positional arguments:
    id
  
  options:
    -h, --help            show this help message and exit
    --globs GLOBS         what this claim writes (recorded on the item too); path globs, comma-
                          separated (a.py,src/**) or a JSON array; repeat the flag to add more --
                          every value is kept
    --note NOTE
    --force
    --no-worktree
    --resources RESOURCES
                          the resources this claim reserves, e.g. 'gpu:2' (recorded on the item too)
  
  '''
# ---
# name: test_help[ddflow cleanup]
  '''
  usage: ddflow cleanup [-h] [--apply]
  
  options:
    -h, --help  show this help message and exit
    --apply
  
  '''
# ---
# name: test_help[ddflow companions add]
  '''
  usage: ddflow companions add [-h] [--id ID] [--agents AGENTS] [--dry-run] [--force]
  
  options:
    -h, --help       show this help message and exit
    --id ID          comma-separated; default: every installed one
    --agents AGENTS  comma-separated (default: claude)
    --dry-run        show the exact config entry that would be written, and write nothing
    --force          register one that is not installed
  
  '''
# ---
# name: test_help[ddflow companions list]
  '''
  usage: ddflow companions list [-h] [--no-probe] [--verify] [--id ID]
  
  options:
    -h, --help  show this help message and exit
    --no-probe  skip the detection probes
    --verify    launch each MCP companion and require an answer to `initialize` (spawns processes;
                opt-in; exit 1 = one is not an MCP server, 2 = could not tell)
    --id ID     with --verify: comma-separated ids to launch (even if not installed)
  
  '''
# ---
# name: test_help[ddflow companions]
  '''
  usage: ddflow companions [-h] [--verify] [--id ID] {list,add} ...
  
  positional arguments:
    {list,add}
      list      what is known, installed and registered
      add       register installed companions in an agent's MCP config
  
  options:
    -h, --help  show this help message and exit
    --verify    launch each MCP companion and require an answer to `initialize` (spawns processes;
                opt-in; exit 1 = one is not an MCP server, 2 = could not tell)
    --id ID     with --verify: comma-separated ids to launch (even if not installed)
  
  '''
# ---
# name: test_help[ddflow complete]
  '''
  usage: ddflow complete [-h] [--sha SHA] [--model MODEL] [--force] [--changelog CHANGELOG] [--regression-test REGRESSION_TEST] id
  
  positional arguments:
    id
  
  options:
    -h, --help            show this help message and exit
    --sha SHA
    --model MODEL         the AUTHOR's model, for independence check
    --force
    --changelog CHANGELOG
                          'Added: text' (Added|Changed|Deprecated|Removed|Fixed|Security), or skip /
                          internal to keep it out of the changelog; optional
    --regression-test REGRESSION_TEST
                          for a fix task: the test that now guards the bug(s) it fixes; closes them
                          (as `bug fixed` would) and completes. Repeat for several.
  
  '''
# ---
# name: test_help[ddflow config]
  '''
  usage: ddflow config [-h] [--explain] [--filter FILTER] [--set SET] [--append-toml APPEND_TOML] [--local] [value ...]
  
  positional arguments:
    value                 the value, when --set is used; or `KEY VALUE` with no --set (ddflow config
                          review.max_rounds 0 --local)
  
  options:
    -h, --help            show this help message and exit
    --explain
    --filter FILTER
    --set SET             edit one key in place, e.g. --set gate.unit_tests.command 'pytest -q'
    --append-toml APPEND_TOML
                          append this TOML to .ddflow/config.toml (validated first)
    --local               write --set/--append-toml to the git-ignored .ddflow/local/config.toml:
                          this machine's endpoints, hosts, key variables and sizing, never committed
  
  '''
# ---
# name: test_help[ddflow decision add]
  '''
  usage: ddflow decision add [-h] [--id ID] --title TITLE --decision DECISION [--context CONTEXT] [--consequences CONSEQUENCES] [--alternatives ALTERNATIVES] [--globs GLOBS] [--tags TAGS] [--sources SOURCES] [--item ITEM] [--by BY] [--status {proposed,accepted,superseded}] [--supersedes SUPERSEDES] [--new | --extends ID | --duplicate-of ID | --related ID | --check]
  
  options:
    -h, --help            show this help message and exit
    --id ID
    --title TITLE
    --decision DECISION   what was DECIDED (not what was discussed)
    --context CONTEXT     the forces: why a decision was needed
    --consequences CONSEQUENCES
                          what it costs, incl. what it makes harder
    --alternatives ALTERNATIVES
                          what was rejected, and why
    --globs GLOBS         the code this governs; without it the decision can only be found by search
    --tags TAGS
    --sources SOURCES     where this came from: an ADR path, a URL, a commit sha (comma-separated)
    --item ITEM
    --by BY               operator | agent | a name
    --status {proposed,accepted,superseded}
    --supersedes SUPERSEDES
    --new                 answer a possible-duplicate refusal: this is a different record, file it
    --extends ID          answer it: this adds to record ID -- appended to ID while it is open and
                          unclaimed, else filed as a new record linked to it
    --duplicate-of ID     answer it: this is the same thing as record ID (handled like --extends)
    --related ID          answer it: a different record that is related to ID; linked both ways
    --check               dry run: print the existing records this would be refused as a duplicate
                          of and write nothing (exit 0 with candidates, 2 with none)
  
  '''
# ---
# name: test_help[ddflow decision applicable]
  '''
  usage: ddflow decision applicable [-h] id
  
  positional arguments:
    id
  
  options:
    -h, --help  show this help message and exit
  
  '''
