    --query QUERY  rank by relevance instead of recency
    --limit LIMIT
    --all          include forgotten memories
  
  '''
# ---
# name: test_help[ddflow memory]
  '''
  usage: ddflow memory [-h] {add,list,forget} ...
  
  positional arguments:
    {add,list,forget}
      add              remember one fact (refused over [memory] max_chars)
      list             live memories, newest first (exit 2 = none)
      forget           stop believing a memory; kept, with the reason
  
  options:
    -h, --help         show this help message and exit
  
  '''
# ---
# name: test_help[ddflow merge]
  '''
  usage: ddflow merge [-h] [--message MESSAGE] [--keep] [--allow-dirty] [--allow-empty] [--branch BRANCH] [--model MODEL] id
  
  positional arguments:
    id
  
  options:
    -h, --help         show this help message and exit
    --message MESSAGE
    --keep
    --allow-dirty
    --allow-empty      land a branch with no commits ahead of its target (refused by default: it
                       would record the item merged with nothing landed)
    --branch BRANCH    for an item claimed without a worktree: the branch to land (default: the one
                       checked out in the worktree you are standing in)
    --model MODEL      the AUTHOR's model. In PR mode completion happens later, at `pr sync`, and
                       the reviewer-independence check needs it then
  
  '''
# ---
# name: test_help[ddflow next]
  '''
  usage: ddflow next [-h] [--phase PHASE] [--kind {task,phase}]
  
  options:
    -h, --help           show this help message and exit
    --phase PHASE        limit to this phase; exit 1 if it names no phase or item
    --kind {task,phase}
  
  '''
# ---
# name: test_help[ddflow onboard]
  '''
  usage: ddflow onboard [-h] [--apply] [--accept NAME] [{status,preflight,legacy,memory,test-gate,verify}]
  
  positional arguments:
    {status,preflight,legacy,memory,test-gate,verify}
                          which stage (default status: the standing drift report)
  
  options:
    -h, --help            show this help message and exit
    --apply               act on the stage's proposal (preflight/legacy/memory)
    --accept NAME         approve one named item (repeatable); without it, apply acts on everything
                          the report marked safe
  
  '''
# ---
# name: test_help[ddflow phase add]
  '''
  usage: ddflow phase add [-h] [--title TITLE] [--needs NEEDS] [--globs GLOBS] [--tags TAGS] [--body BODY] [--priority PRIORITY] [--line LINE] [--readd] [--new | --extends ID | --duplicate-of ID | --related ID | --check] id
  
  positional arguments:
    id
  
  options:
    -h, --help           show this help message and exit
    --title TITLE
    --needs NEEDS
    --globs GLOBS        path globs, comma-separated (a.py,src/**) or a JSON array; repeat the flag
                         to add more -- every value is kept
    --tags TAGS
    --body BODY
    --priority PRIORITY
    --line LINE          release line (default: the current one)
    --readd              file a REMOVED item's id again. An id still in the queue is always refused:
                         change it with `ddflow update`
    --new                answer a possible-duplicate refusal: this is a different record, file it
    --extends ID         answer it: this adds to record ID -- appended to ID while it is open and
                         unclaimed, else filed as a new record linked to it
    --duplicate-of ID    answer it: this is the same thing as record ID (handled like --extends)
    --related ID         answer it: a different record that is related to ID; linked both ways
    --check              dry run: print the existing records this would be refused as a duplicate of
                         and write nothing (exit 0 with candidates, 2 with none)
  
  '''
