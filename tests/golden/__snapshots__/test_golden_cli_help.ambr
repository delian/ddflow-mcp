    --title TITLE
    --body BODY
    --needs NEEDS
    --tags TAGS
    --line LINE
    --resources RESOURCES
    --globs GLOBS         REPLACES the item's globs (and a claimed item's lease) with these; path
                          globs, comma-separated (a.py,src/**) or a JSON array; repeat the flag to
                          add more -- every value is kept
    --priority PRIORITY
    --worktree WORKTREE   rebind the item (and your live lease on it) to this linked worktree and
                          the branch checked out there -- the way out of a binding to the wrong tree
  
  '''
# ---
# name: test_help[ddflow upgrade]
  '''
  usage: ddflow upgrade [-h] [--plan]
  
  options:
    -h, --help  show this help message and exit
    --plan      print the plan (the default, and the only mode so far; nothing is written)
  
  '''
# ---
# name: test_help[ddflow verify]
  '''
  usage: ddflow verify [-h] [--all] [--phase PHASE] [--limit LIMIT] [--file-bugs] [--reopen] [--reason REASON] [--force] [--pack] [--judge] [id]
  
  positional arguments:
    id               one done task; omit with --all/--phase
  
  options:
    -h, --help       show this help message and exit
    --all            every done task, worst first
    --phase PHASE    every done task under this phase
    --limit LIMIT    how many of the worst to list (20)
    --file-bugs      file a bug for each completion that does not hold
    --reopen         send a task whose completion fails back to the queue
    --reason REASON  with --reopen: why (default: the failed claims)
    --force          with --reopen: even when the completion holds
    --pack           print the evidence pack for an independent verifier
    --judge          have the configured cross-family reviewer judge it (gate: verify)
  
  '''
# ---
# name: test_help[ddflow version cut]
  '''
  usage: ddflow version cut [-h] [--bump {,major,minor,patch}] [--version SET_VERSION] [--push] [--dry-run] [--line LINE] [--changelog] [--force]
  
  options:
    -h, --help            show this help message and exit
    --bump {,major,minor,patch}
    --version SET_VERSION
                          exact MAJOR.MINOR.PATCH
    --push                publish the tag (and branches) to the remote
    --dry-run
    --line LINE           a maintenance line (default: the current one)
    --changelog           also write the version's section into CHANGELOG.md, committed with the cut
                          (in a release request under gitflow + pr); never written without this flag
    --force               with --changelog: replace a hand-edited changelog
  
  '''
