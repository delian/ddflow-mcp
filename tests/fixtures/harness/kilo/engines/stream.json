      }
    },
    {
      "when": {
        "path": "type",
        "equals": "tool_use"
      },
      "emit": "tool",
      "fields": {
        "name": "part.tool",
        "action": "part.state.input.action",
        "error": "part.state.error",
        "output": "part.state.output",
        "status": "part.state.status"
      }
    },
    {
      "when": {
        "path": "type",
        "equals": "step_finish"
      },
      "emit": "usage",
      "fields": {
        "tokens": "part.tokens.total",
        "cost": "part.cost"
      }
    },
    {
      "when": {
        "path": "type",
        "equals": "error"
      },
      "emit": "error",
      "fields": {
        "message": "error.data.message"
      }
    }
  ],
